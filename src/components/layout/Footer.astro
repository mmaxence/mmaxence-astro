---
import AnimatedContent from '../ui/AnimatedContent.astro';

const currentYear = new Date().getFullYear();
const author = "Maxence Mauduit";
---

<footer class="w-full" role="contentinfo">
  <div class="max-w-2xl mx-auto px-4 py-16 text-center">
    {/* Top separator */}
    <hr class="border-t border-theme mb-16" />

    <AnimatedContent delay={0}>

    {/* Conversational CTA */}
    <p class="text-base md:text-lg font-body leading-relaxed text-theme">
      If you're navigating complex product decisions or scaling challenges,
      I'm always happy to exchange perspectives.
    </p>
    <p class="text-base md:text-lg font-body leading-relaxed mt-2 text-theme">
      Reach out at{' '}
      <a href="mailto:contact@mmaxence.me" class="inline-card">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="inline-card-icon" style="opacity: 0.6;"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        contact@mmaxence.me
      </a>
    </p>

    {/* Social icons */}
    <div class="flex items-center justify-center gap-4 mt-8">
      <a
        href="https://www.linkedin.com/in/mmaxence/"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social-link text-theme"
        title="LinkedIn"
        aria-label="LinkedIn profile"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="display: block;">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a
        href="https://x.com/mmaxence"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social-link text-theme"
        title="X"
        aria-label="X profile"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="display: block;">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <a
        href="https://bsky.app/profile/mmaxence.bsky.social"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social-link text-theme"
        title="Bluesky"
        aria-label="Bluesky profile"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="display: block;">
          <path d="M5.203 3.392c2.752 2.066 5.713 6.255 6.797 8.503 1.084-2.248 4.045-6.437 6.797-8.503C20.78 1.92 24 .787 24 4.46c0 .733-.42 6.156-.667 7.037-.857 3.062-3.984 3.844-6.766 3.371 4.864.828 6.103 3.572 3.43 6.316-5.075 5.215-7.296-1.31-7.865-2.984-.104-.307-.153-.45-.153-.328 0-.122-.049.021-.153.328-.569 1.674-2.79 8.199-7.864 2.984-2.674-2.744-1.435-5.488 3.43-6.316-2.783.473-5.91-.31-6.766-3.37C.42 10.614 0 5.191 0 4.458 0 .788 3.22 1.92 5.203 3.392z"/>
        </svg>
      </a>
      <a
        href="https://mmaxence.substack.com"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social-link text-theme"
        title="Substrate on Substack"
        aria-label="Substrate newsletter on Substack"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="display: block;">
          <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
        </svg>
      </a>
      <a
        href="https://github.com/mmaxence"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-social-link text-theme"
        title="GitHub"
        aria-label="GitHub profile"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="display: block;">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>

    {/* Copyright */}
    <p class="mt-8 text-sm text-theme-muted">
      &copy; {currentYear} {author}
    </p>
    <a href="/about/" class="footer-about-link">About this site</a>
    </AnimatedContent>
  </div>
</footer>

<style>
  .footer-social-link {
    opacity: 0.6;
    transition: opacity 0.3s ease;
    border: none;
    text-decoration: none;
  }

  .footer-social-link:hover {
    opacity: 1;
    background-color: transparent;
  }

  /* Override global link ::after for social icons */
  .footer-social-link::after {
    display: none !important;
  }

  .footer-about-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--theme-text-muted);
    opacity: 0.6;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer-about-link:hover {
    opacity: 1;
  }

  .footer-about-link::after {
    display: none !important;
  }
</style>
