---
import { navigationGroups } from '../../data/navigation';
const currentYear = new Date().getFullYear();
const elsewhere = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mmaxence/' },
  { label: 'GitHub', href: 'https://github.com/mmaxence' },
  { label: 'Substrate', href: 'https://mmaxence.substack.com/' },
  { label: 'Bluesky', href: 'https://bsky.app/profile/mmaxence.bsky.social' },
  { label: 'X', href: 'https://x.com/mmaxence' },
];
---
<footer class="site-footer max-w-5xl mx-auto px-4 md:px-8 lg:px-12" aria-label="Site footer">
  <div class="footer-top">
    <div class="contact">
      <p class="eyebrow">Keep in touch</p>
      <h2>Always happy to<br />exchange perspectives.</h2>
      <a class="email" href="mailto:contact@mmaxence.me">contact@mmaxence.me</a>
    </div>
    <nav class="directory" aria-label="Site directory">
      {navigationGroups.map(group => (
        <div>
          <h3>{group.title}</h3>
          <ul>{group.links.map(link => <li><a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a></li>)}</ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="footer-bottom">
    <a class="signature" href="/">Maxence Mauduit <span>© {currentYear}</span></a>
    <nav aria-label="Elsewhere"><ul class="elsewhere">{elsewhere.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>
  </div>
</footer>
<style>
.site-footer { width:100%; margin-top:3rem; padding-bottom:2rem; }
.footer-top { border-top:1px solid var(--theme-text); padding:3rem 0; display:grid; grid-template-columns:1fr 1.4fr; gap:3rem; }
.eyebrow, h3 { font-family:var(--font-mono, monospace); font-size:.75rem; font-weight:400; color:var(--theme-text-muted); margin:0 0 1rem; }
h2 { font-family:var(--font-mono, monospace); font-size:1.5rem; line-height:1.3; font-weight:400; margin:0 0 1.25rem; }
.email { font-size:.85rem; }
.directory { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; }
ul { list-style:none; padding:0; margin:0; }
li { margin:0; }
a { display:inline-block; color:var(--theme-text); border:0; text-decoration:none; padding:.4rem 0; font-size:.8rem; }
a:hover { background:none; text-decoration:underline; text-underline-offset:.25em; }
a::after { display:none; }
a:focus-visible { outline:2px solid var(--theme-text); outline-offset:4px; }
a[aria-current] { text-decoration:underline; text-underline-offset:.25em; }
.footer-bottom { border-top:1px solid var(--theme-border); padding-top:1.25rem; display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:1rem 2rem; }
.signature, .elsewhere a { font-family:var(--font-mono, monospace); font-size:.75rem; }
.signature span { margin-left:.75rem; color:var(--theme-text-muted); }
.elsewhere { display:flex; flex-wrap:wrap; gap:.25rem 1rem; }
.elsewhere a, .elsewhere span { color:var(--theme-text-muted); }
@media(max-width:767px) { .footer-top { grid-template-columns:1fr; gap:2.5rem; padding:2.5rem 0; } .directory { gap:1rem; } }
@media(max-width:359px) { .directory { grid-template-columns:1fr 1fr; row-gap:1.5rem; } }
</style>
