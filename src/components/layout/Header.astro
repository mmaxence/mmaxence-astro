---
const menuItems = [
  { name: "Work", url: "/work/" },
  { name: "Writing", url: "/blog/" },
  { name: "Experience", url: "/timeline/" },
];
const desktopMenuItems = menuItems;

const author = "Maxence Mauduit";

// Get current pathname
const currentPath = Astro.url.pathname;

// Function to check if a menu item is active
function isActive(url: string): boolean {
  if (url === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(url) || (url === '/blog/' && currentPath.startsWith('/deepdives/'));
}
---

<header class:list={["header-sticky header-border", { "work-navigation": currentPath === "/work/" || currentPath === "/work" }]}>
  <nav class="header-nav pt-6 md:pt-16 pb-4 px-4 md:px-8 lg:px-12" role="navigation" aria-label="Primary">
    <div class="flex flex-col md:flex-row items-start md:items-baseline justify-between max-w-5xl mx-auto gap-3 md:gap-6">
      <a href="/" class="header-logo-link flex flex-row items-center mb-0 pl-0 grow md:mr-3 no-underline hover:bg-transparent border-none group">
        <svg class="header-logo-svg mr-2 flex-shrink-0 transition-transform duration-300 group-hover:rotate-12 group-hover:scale-110 self-start mt-[1px]" width="24" height="24" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="512" height="512" rx="256" class="fill-[var(--theme-bg)]"/>
          <path d="M256 58.5142L427.028 157.257V354.743L256 453.486L84.9725 354.743V157.257L256 58.5142Z" class="fill-[var(--theme-text)]"/>
          <rect x="173.248" y="256" width="117.029" height="117.029" transform="rotate(-45 173.248 256)" class="fill-[var(--theme-bg)]"/>
        </svg>
        <div class="flex flex-col">
          <p class="text-base md:text-[1.25rem] leading-tight transition-colors duration-300 mb-0 text-theme">
            {author}
          </p>
          <div class="header-subtitle flex flex-wrap items-center gap-x-1.5 gap-y-0.5 mt-0.5">
            <span class="text-sm md:text-base font-body font-normal transition-colors duration-300 leading-tight text-theme-muted">
              Product Designer
            </span>
          </div>
        </div>
      </a>
      {/* Desktop Navigation */}
      <div class="hidden md:flex items-center self-baseline">
        {desktopMenuItems.length > 0 && (
          <ul class="flex gap-5 list-none p-0 m-0">
            {desktopMenuItems.map((item) => {
              const active = isActive(item.url);
              return (
              <li class="text-base font-normal inline-block relative transition-all duration-150">
                    <a
                      class={`prefetch-link px-1 py-1 transition-colors duration-300 ${active ? 'nav-active text-theme-accent' : 'text-theme-muted'}`}
                      href={item.url}
                      title={`${item.name} page`}
                      data-prefetch="true"
                      aria-current={active ? "page" : undefined}
                    >
                  {item.name}
                </a>
              </li>
            );
            })}
          </ul>
        )}
      </div>

      <mobile-navigation>
        <button id="mobile-menu-fab" class="mobile-menu-fab" type="button" aria-label="Open navigation" aria-haspopup="dialog" aria-controls="mobile-navigation-dialog" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg><span>Menu</span>
        </button>
        <dialog id="mobile-navigation-dialog" class="mobile-menu-dialog" aria-labelledby="mobile-navigation-title">
          <div class="mobile-menu-heading"><span id="mobile-navigation-title">Explore</span><button type="button" data-menu-close aria-label="Close navigation" autofocus><svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5"/></svg></button></div>
          <nav aria-label="Mobile navigation"><ul class="mobile-menu-list">
            {[{name:'Home',url:'/'},...menuItems].map(item => <li><a href={item.url} aria-current={isActive(item.url)?'page':undefined}><span>{item.name}</span><span class="menu-current" aria-hidden="true"></span></a></li>)}
          </ul></nav>
          <div class="mobile-menu-footer">
            <a class="mobile-contact" href="mailto:contact@mmaxence.me">Let’s talk<span>contact@mmaxence.me</span></a>
            <div class="mobile-menu-secondary"><a href="https://www.linkedin.com/in/mmaxence/" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://github.com/mmaxence" target="_blank" rel="noopener noreferrer">GitHub</a><button type="button" data-menu-reset>Reset theme</button></div>
          </div>
        </dialog>
      </mobile-navigation>
    </div>
  </nav>
</header>

<style>
  .header-logo-link {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .header-logo-link:hover {
    transform: translateX(4px);
  }
  
  /* All nav links need inline-block for consistent alignment */
  nav ul li a {
    display: inline-block;
  }

  /* Desktop nav link hover - muted to full color */
  nav ul li a:not(.nav-active) {
    transition: color 0.2s ease;
  }

  .header-nav > div > .hidden a:not(.nav-active):hover {
    color: var(--theme-text) !important;
    animation: nav-giggle 4s ease-in-out 1s infinite;
  }

  /* Easter egg: hover too long without clicking and the link giggles.
     Giggle occupies first 10% of the 4s cycle (0.4s), idle for the remaining 90% */
  @keyframes nav-giggle {
    0%   { transform: rotate(0deg) translateX(0); }
    2%   { transform: rotate(-3deg) translateX(-2px); }
    4%   { transform: rotate(3deg) translateX(2px); }
    6%   { transform: rotate(-2deg) translateX(-1px); }
    8%   { transform: rotate(1deg) translateX(1px); }
    10%  { transform: rotate(0deg) translateX(0); }
    100% { transform: rotate(0deg) translateX(0); }
  }

  /* Active navigation item styles */
  .nav-active {
    font-weight: 600;
  }

  .nav-active:hover {
    opacity: 0.8;
  }

  mobile-navigation { display: contents; }
  .mobile-menu-fab { position:fixed;right:max(20px,env(safe-area-inset-right));bottom:calc(20px + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 20px;border:1px solid var(--theme-text);border-radius:28px;background:var(--theme-text);color:var(--theme-bg);font:500 .85rem var(--font-body);z-index:101;cursor:pointer;transition:transform .18s ease;touch-action:manipulation; }
  .mobile-menu-fab span,.mobile-menu-list a > span { color:inherit; }
  .mobile-menu-fab:active { transform:scale(.95); }
  .mobile-menu-dialog { position:fixed;inset:auto 0 0;margin:0 12px calc(12px + env(safe-area-inset-bottom)) auto;width:calc(100% - 24px);max-width:420px;max-height:calc(100dvh - 32px - env(safe-area-inset-top) - env(safe-area-inset-bottom));padding:24px;border:1px solid var(--theme-border);border-radius:24px;background:var(--theme-bg);color:var(--theme-text);overflow:auto;overscroll-behavior:contain; }
  .mobile-menu-dialog::backdrop { background:rgba(20,20,20,.24);backdrop-filter:blur(5px); }
  .mobile-menu-dialog[open] { animation:menu-arrive .24s cubic-bezier(.2,.7,.2,1); }
  .mobile-menu-heading { display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;font:.7rem var(--font-mono);color:var(--theme-text-muted); }
  .mobile-menu-heading button { display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--theme-border);border-radius:50%;background:none;color:var(--theme-text);cursor:pointer; }
  .mobile-menu-list { list-style:none;padding:0;margin:0; }
  .mobile-menu-list li { margin:0; }
  .mobile-menu-dialog .mobile-menu-list li a { display:flex;align-items:center;justify-content:space-between;min-height:60px;padding:8px 0;border-bottom:1px solid var(--theme-border);color:var(--theme-text-muted);font:400 clamp(1.6rem,6vw,2rem)/1.2 var(--font-body);text-decoration:none;letter-spacing:-.035em; }
  .mobile-menu-dialog .mobile-menu-list li a[aria-current] { color:var(--theme-text); }
  .menu-current { width:7px;height:7px;border-radius:50%;background:currentColor;opacity:0;margin-right:8px; }
  [aria-current] .menu-current { opacity:1; }
  .mobile-menu-footer { padding-top:20px; }
  .mobile-contact { display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px;min-height:44px;color:var(--theme-text);font:.85rem var(--font-body);text-decoration:none; }
  .mobile-contact span { color:var(--theme-text-muted);font-size:.72rem; }
  .mobile-menu-secondary { display:flex;align-items:center;gap:20px;margin-top:8px; }
  .mobile-menu-secondary a,.mobile-menu-secondary button { display:flex;align-items:center;min-height:44px;padding:0;border:0;background:none;font:.7rem var(--font-body);color:var(--theme-text-muted);text-decoration:none;cursor:pointer; }
  .mobile-menu-secondary button { margin-left:auto; }
  .mobile-menu-dialog :is(a,button):focus-visible,.mobile-menu-fab:focus-visible { outline:2px solid var(--theme-text);outline-offset:4px; }
  @keyframes menu-arrive { from { opacity:0;transform:translateY(12px); } to { opacity:1;transform:none; } }
  /* Work has its own route controls. Keep global navigation in the header. */
  @media(max-width:767px) {
    .work-navigation .header-nav > div { display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:12px; }
    .work-navigation .mobile-menu-fab { position:static;min-height:48px;padding:0 14px;gap:8px; }
    .work-navigation .mobile-menu-dialog { inset:0 0 auto;margin:calc(12px + env(safe-area-inset-top)) 12px 0 auto; }
  }
  @media(min-width:768px) { .mobile-menu-fab,.mobile-menu-dialog { display:none!important; } }
  @media(prefers-reduced-motion:reduce) { .mobile-menu-dialog[open] { animation:none; }.mobile-menu-fab { transition:none; } }

</style>

<script>
  class MobileNavigation extends HTMLElement {
    private controller?: AbortController;
    private closeMenu?: () => void;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const fab = this.querySelector<HTMLButtonElement>('.mobile-menu-fab');
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      if (!fab || !dialog) return;
      const desktop = matchMedia('(min-width:768px)');
      let previousOverflow = '';
      let locked = false;
      const restore = () => {
        if (locked) document.documentElement.style.overflow = previousOverflow;
        locked = false;
        fab.setAttribute('aria-expanded','false');
      };
      this.closeMenu = () => { if (dialog.open) dialog.close(); restore(); };
      fab.addEventListener('click', () => {
        if (desktop.matches || dialog.open) return;
        previousOverflow = document.documentElement.style.overflow;
        fab.focus({ preventScroll: true });
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        locked = true;
        fab.setAttribute('aria-expanded','true');
      }, { signal });
      dialog.addEventListener('close', restore, { signal });
      dialog.addEventListener('keydown', event => {
        if (event.key !== 'Tab') return;
        const items = [...dialog.querySelectorAll<HTMLElement>('a[href],button:not([disabled])')].filter(item=>item.getClientRects().length);
        const first=items[0],last=items[items.length-1];
        if (!first || !last) return;
        if (event.shiftKey && (document.activeElement===first || document.activeElement===dialog)) { event.preventDefault();last.focus(); }
        else if (!event.shiftKey && document.activeElement===last) { event.preventDefault();first.focus(); }
      }, { signal });
      this.querySelector('[data-menu-close]')?.addEventListener('click', this.closeMenu, { signal });
      let backdropDown = false;
      const outside = (event: MouseEvent) => { const r=dialog.getBoundingClientRect(); return event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom; };
      dialog.addEventListener('pointerdown', event => { backdropDown = event.target===dialog && outside(event); }, { signal });
      dialog.addEventListener('click', event => {
        if (backdropDown && event.target===dialog && outside(event)) this.closeMenu?.();
        backdropDown=false;
        if ((event.target as Element).closest('a[href]')) this.closeMenu?.();
      }, { signal });
      this.querySelector('[data-menu-reset]')?.addEventListener('click', () => {
        (window as Window & { resetThemeToDefault?: () => void }).resetThemeToDefault?.();
        this.closeMenu?.();
      }, { signal });
      desktop.addEventListener('change', () => { if(desktop.matches) this.closeMenu?.(); }, { signal });
      document.addEventListener('astro:before-swap', () => this.closeMenu?.(), { signal });
    }
    disconnectedCallback() { this.closeMenu?.(); this.controller?.abort(); }
  }
  if(!customElements.get('mobile-navigation')) customElements.define('mobile-navigation',MobileNavigation);
</script>

<script>
  // Store current scroll handler so we can clean up on re-init
  let currentScrollHandler = null;

  function initStickyHeader() {
    const header = document.querySelector('.header-sticky');
    if (!header) return;

    // Clean up previous scroll listener if any
    if (currentScrollHandler) {
      window.removeEventListener('scroll', currentScrollHandler);
      currentScrollHandler = null;
    }

    // Only apply sticky behavior on desktop
    const isDesktop = window.matchMedia('(min-width: 768px)').matches;
    if (!isDesktop) {
      header.classList.remove('header-scrolled');
      return;
    }

    const COLLAPSE_THRESHOLD = 80;
    const EXPAND_THRESHOLD = 10;
    let isScrolled = false;
    let ticking = false;

    function updateHeader() {
      const scrollY = window.scrollY;

      if (!isScrolled && scrollY > COLLAPSE_THRESHOLD) {
        header.classList.add('header-scrolled');
        isScrolled = true;
      } else if (isScrolled && scrollY <= EXPAND_THRESHOLD) {
        header.classList.remove('header-scrolled');
        isScrolled = false;
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }

    // Set initial state based on current scroll position WITHOUT animating the
    // correction. Otherwise, on load / view-transition the header renders expanded
    // and then animates to collapsed (or vice-versa), which reads as a "bounce".
    // We snap to the right state instantly here; only real scroll changes animate.
    header.classList.add('header-no-anim');
    if (window.scrollY > COLLAPSE_THRESHOLD) {
      header.classList.add('header-scrolled');
      isScrolled = true;
    } else {
      header.classList.remove('header-scrolled');
      isScrolled = false;
    }
    void header.offsetHeight; // force reflow so the snap is not transitioned
    requestAnimationFrame(() => header.classList.remove('header-no-anim'));

    window.addEventListener('scroll', onScroll, { passive: true });
    currentScrollHandler = onScroll;

    // Cleanup on page transition
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
      currentScrollHandler = null;
    }, { once: true });
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStickyHeader);
  } else {
    initStickyHeader();
  }

  // Re-initialize on page transitions
  document.addEventListener('astro:page-load', () => {
    // Run synchronously so the snap-to-correct-state happens before paint,
    // not 50ms later (which let the wrong state show and then animate).
    initStickyHeader();
  });

  // Re-initialize on resize (desktop <-> mobile transition)
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(initStickyHeader, 150);
  });
</script>
