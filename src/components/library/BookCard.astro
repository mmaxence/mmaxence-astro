---
import type { CollectionEntry } from 'astro:content';

interface Props {
  book: CollectionEntry<'library'>;
}

const { book } = Astro.props;

const featuredImage = book.data.featured_image?.startsWith('/')
  ? book.data.featured_image
  : `/images/${book.data.featured_image}`;
---

{/* Display-only card — book detail pages aren't linked for now. */}
<div class="book-card-wrap">
  <article class="book-card p-6 border border-theme bg-theme rounded-card shadow-theme">
    {book.data.featured_image && (
      <img
        src={featuredImage}
        alt={book.data.title}
        loading="lazy"
        decoding="async"
        class="book-cover w-full h-auto mb-4 rounded-card-image"
      />
    )}
    <h2 class="book-title text-xl font-semibold mb-2 text-theme">
      {book.data.title}
    </h2>
    {book.data.book_author && (
      <h3 class="book-author font-body text-base mb-2 text-theme-muted">
        by {book.data.book_author}
      </h3>
    )}
    {book.data.book_category && (
      <p class="book-description text-sm mb-3 text-theme-muted">
        {book.data.book_category}
      </p>
    )}
  </article>
</div>

<style>
  .book-card {
    border-color: var(--theme-border);
  }
</style>
