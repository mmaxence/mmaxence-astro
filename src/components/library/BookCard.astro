---
import type { CollectionEntry } from 'astro:content';

interface Props {
  book: CollectionEntry<'library'>;
}

const { book } = Astro.props;

const featuredImage = book.data.featured_image?.startsWith('/')
  ? book.data.featured_image
  : `/images/${book.data.featured_image}`;

// Matches getStaticPaths in pages/library/[...slug].astro
const bookUrl = `/library/${book.slug.replace('-review', '')}/`;
---

<a href={bookUrl} class="book-card-link block no-underline">
  <article class="book-card p-6 border border-theme bg-theme rounded-card shadow-theme">
    {book.data.featured_image && (
      <img
        src={featuredImage}
        alt={book.data.title}
        loading="lazy"
        decoding="async"
        class="book-cover w-full mb-4 rounded-card-image"
      />
    )}
    <h3 class="font-mono font-light text-xl md:text-2xl mb-2 text-theme">
      {book.data.title}
    </h3>
    {book.data.book_author && (
      <p class="font-body text-base text-theme-muted">
        by {book.data.book_author}
      </p>
    )}
  </article>
</a>

<style>
  .book-card {
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .book-card-link:hover .book-card {
    border-color: var(--theme-accent);
    box-shadow: var(--shadow-hover, 0 2px 8px rgba(0, 0, 0, 0.12));
    transform: translateY(-1px);
  }

  /* Align ragged rows without cropping covers (full-ratio display is deliberate). */
  .book-cover {
    aspect-ratio: 3 / 4;
    object-fit: contain;
  }
</style>
