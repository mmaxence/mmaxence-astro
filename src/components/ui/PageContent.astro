---
// Wrapper component for consistent page content animation
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<main class={`page-content ${className}`} role="main">
  <slot />
</main>

<style>
  .page-content {
    opacity: 0;
    transform: translateY(12px);
    animation: pageContentFadeIn 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes pageContentFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Re-trigger animation on view transition */
  ::view-transition-new(root) .page-content {
    animation: pageContentFadeIn 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>

<script>
  // Re-trigger the fade-in on real navigations only.
  // `astro:after-swap` fires after a View Transitions navigation swaps in fresh DOM —
  // crucially NOT on the initial page load. Using `astro:page-load` here (which DOES
  // fire on initial load) blanked the whole page on first paint, then re-ran the fade:
  // the load "blink". The initial load already plays the CSS animation once on its own.
  document.addEventListener('astro:after-swap', () => {
    const pageContent = document.querySelector('.page-content');
    if (pageContent) {
      pageContent.style.animation = 'none';
      void pageContent.offsetWidth; // force reflow so the restart takes
      pageContent.style.animation = '';
    }
  });
</script>
