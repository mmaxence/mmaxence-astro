---
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---

<div class={`mb-12 ${className}`}>
  {Astro.slots.has('action') ? (
    <div class="heading-row mb-5" data-reveal style="--r: 0">
      <h1 class="text-4xl md:text-5xl font-mono font-light">{title}</h1>
      <slot name="action" />
    </div>
  ) : (
    <h1 class="text-4xl md:text-5xl font-mono font-light mb-5" data-reveal style="--r: 0">
      {title}
    </h1>
  )}
  <div class="reveal-rule" style="--r: 0" aria-hidden="true"></div>
  {description && (
    <p class="text-base text-theme mt-5" set:html={description} data-reveal style="--r: 1" />
  )}
</div>


<style>
  .heading-row { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:.75rem 1.5rem; }
  .heading-row h1 { margin:0; }
</style>
