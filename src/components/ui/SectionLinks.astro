---
import { navigationGroups } from '../../data/navigation';
interface Props { group: 'work' | 'writing' | 'background' }
const { group } = Astro.props;
const section = navigationGroups.find(item => item.id === group)!;
const current = Astro.url.pathname;
---
<nav class="section-links" aria-label={`${section.title} sections`}>
  {section.links.map(link => <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a>)}
</nav>
<style>
.section-links { display:flex; flex-wrap:wrap; gap:.4rem 1.5rem; margin:-1rem 0 2.5rem; font-family:var(--font-mono, monospace); font-size:.8rem; }
a { display:inline-block; padding:.4rem 0; border:0; color:var(--theme-text-muted); text-decoration:none; }
a[aria-current], a:hover { color:var(--theme-text); }
a:hover { background:none; text-decoration:underline; text-underline-offset:.25em; }
a::after { display:none; }
a:focus-visible { outline:2px solid var(--theme-text); outline-offset:4px; }
</style>
