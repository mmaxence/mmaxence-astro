---
import type { CollectionEntry } from 'astro:content';
import TagList from '../ui/TagList.astro';
import TitleListItem from '../ui/TitleListItem.astro';

interface Props {
  currentPost: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { currentPost, allPosts } = Astro.props;

// Sort by date descending (newest first)
const sorted = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const currentIndex = sorted.findIndex((p) => p.slug === currentPost.slug);
const prevPost = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const nextPost = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;

// Related articles: posts sharing at least one tag, excluding current
const currentTags = currentPost.data.tags || [];
const related = currentTags.length > 0
  ? sorted
      .filter((p) => p.slug !== currentPost.slug)
      .map((p) => ({
        post: p,
        shared: (p.data.tags || []).filter((t: string) => currentTags.includes(t)).length,
      }))
      .filter((r) => r.shared > 0)
      .sort((a, b) => b.shared - a.shared)
      .slice(0, 2)
      .map((r) => r.post)
  : [];

---

{/* Tags */}
{currentTags.length > 0 && (
  <div class="mt-8">
    <TagList tags={currentTags} />
  </div>
)}

{/* Prev / Next navigation */}
<nav class="blog-post-nav mt-16 pt-8 border-t border-theme" aria-label="Blog post navigation">
  <div class="adjacent-posts">
    {prevPost && <div>
      <p class="direction">← Previous</p>
      <a href={`/blog/${prevPost.slug}/`} class="blog-nav-link" data-nav="prev">{prevPost.data.title}</a>
    </div>}
    {nextPost && <div class="next-post">
      <p class="direction">Next →</p>
      <a href={`/blog/${nextPost.slug}/`} class="blog-nav-link" data-nav="next">{nextPost.data.title}</a>
    </div>}
  </div>
</nav>

{/* Related articles */}
{related.length > 0 && (
  <section class="mt-12 pt-8 border-t border-theme">
    <h2 class="text-xl font-mono font-light text-theme mb-6">Related</h2>
    <div>
      {related.map(post => <TitleListItem title={post.data.title} href={`/blog/${post.slug}/`} date={post.data.date} />)}
    </div>
  </section>
)}

<style>
.adjacent-posts { display:grid; grid-template-columns:1fr 1fr; gap:2rem; }
.direction { font-family:var(--font-mono, monospace); font-size:.75rem; color:var(--theme-text-muted); margin:0 0 .65rem; }
.blog-nav-link { font-family:var(--font-mono, monospace); font-size:1.15rem; line-height:1.4; color:var(--theme-text); border:0; text-decoration:none; }
.blog-nav-link:hover { background:none; text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:.22em; }
.blog-nav-link::after { display:none; }
.blog-nav-link:focus-visible { outline:2px solid var(--theme-text); outline-offset:4px; }
.next-post { grid-column:2; text-align:right; }
@media(max-width:600px) { .adjacent-posts { grid-template-columns:1fr; gap:1.5rem; } .next-post { grid-column:auto; text-align:left; } }
</style>

<script>
  // Module-level flag: bind once per page view. astro:before-swap resets it so the
  // astro:page-load init re-binds against the fresh DOM after client-side navs.
  let kbNavBound = false;

  function initBlogKeyboardNav() {
    if (kbNavBound) return;
    const nav = document.querySelector('.blog-post-nav');
    if (!nav) return;

    const prevLink = nav.querySelector('[data-nav="prev"]') as HTMLAnchorElement | null;
    const nextLink = nav.querySelector('[data-nav="next"]') as HTMLAnchorElement | null;

    function onKeydown(e: KeyboardEvent) {
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      // Don't navigate if user is typing in an input
      if (
        e.target instanceof HTMLInputElement ||
        e.target instanceof HTMLTextAreaElement ||
        (e.target instanceof HTMLElement && e.target.isContentEditable)
      ) return;

      if (e.key === 'ArrowLeft' && prevLink) {
        prevLink.click();
      } else if (e.key === 'ArrowRight' && nextLink) {
        nextLink.click();
      }
    }

    kbNavBound = true;
    document.addEventListener('keydown', onKeydown);

    // Cleanup on page transition
    document.addEventListener('astro:before-swap', () => {
      kbNavBound = false;
      document.removeEventListener('keydown', onKeydown);
    }, { once: true });
  }

  // Bind early on hard loads (astro:page-load only fires at window `load` there,
  // which slow images/analytics can delay); the flag prevents double-binding.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogKeyboardNav, { once: true });
  } else {
    initBlogKeyboardNav();
  }
  document.addEventListener('astro:page-load', initBlogKeyboardNav);
</script>
