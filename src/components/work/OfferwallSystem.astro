---
import OfferwallFeed from './OfferwallFeed.astro';
---
<figure class="offerwall-system">
  <offerwall-system class="system-board">
    <div class="system-preview"><OfferwallFeed /></div>
    <div class="system-options">
      <span class="system-kicker">A shared product, their identity</span>
      <h3>The brand changes.<br/>The structure holds.</h3>
      <p>Creative, task and reward stay in the same place. Partners can adapt the surface to their app.</p>
      <fieldset class="theme-options"><legend>Appearance</legend><div><button type="button" data-theme="light" aria-pressed="true"><span class="tone-swatch light" aria-hidden="true"></span>Light</button><button type="button" data-theme="dark" aria-pressed="false"><span class="tone-swatch dark" aria-hidden="true"></span>Dark</button></div></fieldset>
      <fieldset class="accent-options"><legend>Publisher accent</legend><div><button type="button" data-accent="#356253" aria-pressed="true"><span style="--swatch:#356253" aria-hidden="true"></span>Forest</button><button type="button" data-accent="#a44530" aria-pressed="false"><span style="--swatch:#a44530" aria-hidden="true"></span>Terracotta</button><button type="button" data-accent="#665087" aria-pressed="false"><span style="--swatch:#665087" aria-hidden="true"></span>Violet</button></div></fieldset>
      <div class="fixed-hierarchy"><span>Shared hierarchy</span><ol><li><b>01</b>Brand creative</li><li><b>02</b>A clear action</li><li><b>03</b>A visible reward</li></ol></div>
    </div>
  </offerwall-system>
  <figcaption>Try a different appearance, filter offers or open a campaign. Interactive reconstruction with fictional brands and sample points.</figcaption>
</figure>
<script>
  class OfferwallSystem extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      this.querySelectorAll<HTMLButtonElement>('[data-theme],[data-accent]').forEach(button => button.addEventListener('click', () => {
        const key = button.hasAttribute('data-theme') ? 'theme' : 'accent';
        this.querySelectorAll(`[data-${key}]`).forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        const preview = this.querySelector<HTMLElement>('[data-preview]');
        if (!preview) return;
        if (key === 'theme') preview.dataset.tone = button.dataset.theme;
        else preview.style.setProperty('--feed-accent', button.dataset.accent!);
      }));
    }
  }
  if (!customElements.get('offerwall-system')) customElements.define('offerwall-system', OfferwallSystem);
</script>
<style>
  .offerwall-system{margin:0;color:#28382f}
  .system-board{--theme-text:#28382f;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(28px,5vw,85px);padding:clamp(24px,5vw,64px);background:#e8ece5;color:#28382f;border:1px solid #d9dfd5;overflow:hidden;font-family:Arial,Helvetica,sans-serif}
  .system-preview{display:flex;justify-content:center;min-width:0}
  .system-options{max-width:345px;min-width:0}
  .system-kicker{display:block;font:9px/1.6 var(--font-mono,monospace);letter-spacing:.07em;text-transform:uppercase;color:#57675c}
  h3{font:400 clamp(27px,3vw,40px)/1.08 Arial,Helvetica,sans-serif;color:#28382f;letter-spacing:-.045em;margin:17px 0}
  .system-options>p{font:13px/1.7 Arial,Helvetica,sans-serif;color:#5c6a60;max-width:31ch;margin:0 0 31px}
  fieldset{border:0;padding:0;margin:0 0 22px;min-width:0}
  legend{font:10px/1.5 Arial,Helvetica,sans-serif;font-weight:600;margin:0 0 9px;color:#425447;padding:0}
  fieldset>div{display:flex;gap:6px;flex-wrap:wrap}
  button{min-height:44px;appearance:none;display:flex;align-items:center;justify-content:flex-start;gap:7px;border:1px solid #b9c5b9;border-radius:6px;background:transparent;padding:9px 11px;font:11px/1.3 Arial,Helvetica,sans-serif;cursor:pointer;color:#344d3b;box-shadow:none}
  button:hover{border-color:#4e6552}
  button[aria-pressed=true]{background:#f9faf6;border-color:#55735c;color:#1e3a29}
  button:focus-visible{outline:2px solid #28382f;outline-offset:3px}
  .tone-swatch{width:14px;height:14px;border:1px solid #adb8ab;border-radius:50%;display:block;flex:none}
  .tone-swatch.light{background:#fff}
  .tone-swatch.dark{background:#242b27;border-color:#242b27}
  .accent-options button{padding:9px 10px;gap:6px;font-size:10px}
  .accent-options button>span{width:12px;height:12px;flex:none;border-radius:50%;background:var(--swatch)}
  .fixed-hierarchy{border-top:1px solid #c7d0c4;margin-top:29px;padding-top:20px}
  .fixed-hierarchy>span{font:9px/1.5 var(--font-mono,monospace);color:#657361;text-transform:uppercase;letter-spacing:.06em}
  .fixed-hierarchy ol{list-style:none;margin:13px 0 0;padding:0;display:grid;gap:10px}
  .fixed-hierarchy li{display:flex;gap:14px;align-items:center;font:12px/1.4 Arial,Helvetica,sans-serif;color:#3e5142;margin:0;padding:0}
  .fixed-hierarchy b{font:9px/1.4 var(--font-mono,monospace);font-weight:400;color:#6f7e6c}
  figcaption{font:.75rem/1.7 var(--font-mono,monospace);color:var(--theme-text-muted);margin-top:12px}
  @media(max-width:680px){.system-board{grid-template-columns:1fr;gap:32px;padding:25px 20px}.system-options{max-width:330px;width:100%;margin:auto}.system-options>p{max-width:none;margin-bottom:23px}.fixed-hierarchy{margin-top:20px}.fixed-hierarchy ol{display:flex;flex-wrap:wrap;gap:11px 18px}.fixed-hierarchy li{font-size:10px;gap:6px}}
  @media(max-width:360px){.system-board{padding:20px 14px}.accent-options button{padding:8px;font-size:9px}.accent-options button>span{width:10px;height:10px}h3{font-size:28px}}
</style>
