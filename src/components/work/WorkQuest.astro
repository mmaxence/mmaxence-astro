---
import { workEntries } from '../../data/work';
const chapters = [
  { slug: 'lockscreen', title: 'Lockscreen', x: 10, y: 42 },
  { slug: 'offerwall', title: 'Offerwall', x: 27, y: 59 },
  { slug: 'game-ua-multi-mission', title: 'Game UA', x: 44, y: 49 },
  { slug: 'interaction-composer', title: 'Composer', x: 61, y: 34 },
  { slug: 'buzzvil-mediums', title: 'Buzzvil mediums', x: 78, y: 43 },
  { slug: 'hanji', title: 'Hanji', x: 95, y: 57 },
].map(chapter => ({ ...chapter, years: workEntries.find(work => work.slug === chapter.slug)!.years }));
---
<work-quest>
  <h1 class="sr-only">Work</h1>
  <div class="quest-stage" id="project-path" tabindex="0" role="region" aria-label="Six project stories">

    <div class="world-loader" aria-hidden="true"><div class="loader-orb"><span data-load-percent>0%</span></div></div>
    <canvas class="quest-canvas" aria-hidden="true"></canvas>
    <svg class="fallback-trail" viewBox="0 0 1000 500" preserveAspectRatio="none" aria-hidden="true"><path d="M-70 170 C130 100 180 400 300 310 S480 100 610 170 S820 350 1070 240" /></svg>
    <div class="workshop-label" data-workshop-label hidden><a href="#open-source" data-open-contributions aria-haspopup="dialog" aria-controls="open-source-dialog"><span>Open-source workshop</span><small>Community contributions</small></a></div>
    <div class="quest-markers" role="group" aria-label="Project timeline">
      {chapters.map(chapter => <div class="quest-stop" id={chapter.slug} data-map-x={chapter.x} data-map-y={chapter.y} style={`--node-x:${chapter.x}%;--node-y:${chapter.y}%`}>
        <a class="quest-marker no-underline" href={`/work/${chapter.slug}/`} data-quest-select={chapter.slug} aria-label={`${chapter.title}, ${chapter.years}. Open story.`}>
          <svg class="stop-ring" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><circle class="ring-value" cx="10" cy="10" r="7.5" pathLength="100" /><path class="ring-check" d="m6.5 10 2.3 2.3 4.7-4.6" /></svg>
          <span class="stop-copy"><span class="stop-title">{chapter.title}</span><span class="stop-years">{chapter.years}</span><span class="stop-progress-label" data-stop-progress-label hidden></span></span><span class="sr-only" data-stop-percent>0%</span>
        </a>
      </div>)}
    </div>
  </div>
  <div class="quest-controls">
    <details class="journey-stats">
      <summary aria-label="Your exploration progress">
        <span class="journey-level"><svg viewBox="0 0 48 48" aria-hidden="true"><circle class="completion-track" cx="24" cy="24" r="20"/><circle class="completion-arc" cx="24" cy="24" r="20" pathLength="100"/></svg><span>LV</span><b data-level>0</b></span>
        <span class="journey-readout"><span class="journey-rank">Explorer</span><span data-next-level>0 of 6 complete</span></span>
      </summary>
      <div class="journey-popover"><p><b data-xp>0</b> exploration XP</p><p><b data-completed>0</b> of 6 projects completed.</p><p>One completed project = one level. Partial reading earns XP. Saved in this browser.</p><button class="mobile-world-motion" type="button" data-mobile-motion>Pause world motion</button><button type="button" data-reset>Reset journey</button><span role="status" data-reset-status></span></div>
    </details>
    <div class="route-controls">
      <button type="button" data-step="-1" aria-label="Travel to the previous project"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m12 5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
      <a class="station-control no-underline" data-station-link href="/work/lockscreen/" aria-label="Open Lockscreen story">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="3" y="3" width="14" height="11" rx="4"/><path d="M3 9h14M10 3v6M6 17h8M10 14v3"/></svg>
        <span data-station-name>Lockscreen</span><kbd>Enter</kbd>
      </a>
      <button type="button" data-step="1" aria-label="Travel to the next project"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m8 5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
    </div>
    <div class="world-controls" role="group" aria-label="World controls"><div class="zoom-controls" role="group" aria-label="Globe zoom"><button type="button" data-zoom="-.1" aria-label="Zoom out"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 10h10"/></svg></button><button type="button" data-zoom=".1" aria-label="Zoom in"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 10h10M10 5v10"/></svg></button></div><button class="motion-control" type="button" data-motion aria-pressed="false" aria-label="Pause world motion" title="Pause motion"><svg width="12" height="12" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M3 1v8M7 1v8" stroke="currentColor" stroke-width="1.3" /></svg><span data-motion-label>Pause</span></button></div>
  </div>
  <aside class="journey-reward" hidden data-journey-reward aria-label="Exploration reward">
    <span class="reward-symbol" aria-hidden="true">✓</span><div role="status" aria-live="polite"><strong data-reward-title></strong><p data-reward-detail></p></div><button type="button" data-dismiss-reward aria-label="Dismiss progress reward">×</button>
  </aside>
  <noscript><style>work-quest .world-loader{display:none!important}</style><nav aria-label="All project stories"><ul>{chapters.map(chapter => <li><a href={`/work/${chapter.slug}/`}>{chapter.title}</a></li>)}</ul></nav></noscript>
</work-quest>

<script>
  import { getProgress, getSummary, resetProgress, takeWorkRewards, WORK_SLUGS } from '../../lib/work-progress';
  import type { WorldHandle } from './work-quest-world';

  let worldHasLoaded = false;

  class WorkQuest extends HTMLElement {
    private controller?: AbortController;
    private world?: WorldHandle;
    private alive = false;
    private motion = true;
    private panPosition = 0;
    private saveTimer = 0;
    private loaderTimer = 0;
    private rewardTimer = 0;
    private rewardHideTimer = 0;
    private restoring = false;
    private pendingStationFocus = false;
    private focusFrame = 0;
    private station: string = WORK_SLUGS[0];
    private active: string | null = null;
    private reduced = matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.alive = true;
      this.dataset.world='loading';this.setAttribute('aria-busy','true');
      this.loadingProgress(5);this.removeAttribute('data-loader-visible');
      clearTimeout(this.loaderTimer);
      this.loaderTimer=window.setTimeout(()=>{if(!worldHasLoaded&&this.alive&&this.dataset.world==='loading')this.setAttribute('data-loader-visible','');},250);
      this.motion = !this.reduced.matches;
      this.panPosition = Number.isFinite(history.state?.workQuestPan) ? Math.min(1,Math.max(0,history.state.workQuestPan)) : 0;
      this.station=WORK_SLUGS.find(slug=>slug===history.state?.workQuestStation)??WORK_SLUGS[0];
      this.updateStation(this.station);
      this.updateProgress();
      this.updateMotion();
      document.addEventListener('work-contributions-toggle',event=>{
        if((event as CustomEvent<boolean>).detail)this.world?.setMotion(false);
        else this.updateMotion();
      },{signal});
      this.querySelectorAll<HTMLElement>('[data-open-contributions]').forEach(link=>{
        link.addEventListener('pointerenter',event=>{if(event.pointerType==='mouse')this.activate('open-source');},{signal});
        link.addEventListener('pointerleave',()=>this.activate(null),{signal});
        link.addEventListener('focus',()=>this.activate('open-source'),{signal});
        link.addEventListener('blur',()=>this.activate(null),{signal});
      });
      this.querySelectorAll<HTMLAnchorElement>('[data-quest-select]').forEach((link,index) => {
        const slug = link.dataset.questSelect!;
        link.addEventListener('pointerenter', event => { if(event.pointerType==='mouse') this.activate(slug); }, {signal});
        link.addEventListener('pointerleave', () => { if(document.activeElement!==link) this.activate(null); }, {signal});
        link.addEventListener('focus', () => { this.activate(slug);if(!this.restoring&&link.matches(':focus-visible')){if(this.dataset.world==='ready')this.world?.select(slug);else link.scrollIntoView({block:'nearest',inline:'center',behavior:'instant'});} }, {signal});
        link.addEventListener('blur', () => this.activate(null), {signal});
        link.addEventListener('keydown', event => {
          if(event.metaKey||event.ctrlKey||event.altKey) return;
          const offset = ['ArrowRight','ArrowDown'].includes(event.key) ? 1 : ['ArrowLeft','ArrowUp'].includes(event.key) ? -1 : 0;
          if(!offset&&event.key!=='Home'&&event.key!=='End') return;
          event.preventDefault();
          const next = event.key==='Home'?0:event.key==='End'?5:Math.max(0,Math.min(5,index+offset));
          this.querySelector<HTMLAnchorElement>(`[data-quest-select="${WORK_SLUGS[next]}"]`)?.focus({preventScroll:true});
        }, {signal});
      });
      this.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button => button.addEventListener('click', () => {
        this.travel(Number(button.dataset.step)<0?-1:1);
      }, {signal}));
      this.querySelector('[data-station-link]')?.addEventListener('click',()=>this.persistPan(),{signal});
      this.querySelector<HTMLElement>('.route-controls')?.addEventListener('keydown',event=>{
        if(event.altKey||event.metaKey||event.ctrlKey||event.repeat)return;
        if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();this.travel(event.key==='ArrowRight'?1:-1);}
      },{signal});
      const stats=this.querySelector<HTMLDetailsElement>('.journey-stats');
      document.addEventListener('pointerdown',event=>{
        if(stats?.open && event.target instanceof Node && !stats.contains(event.target)) stats.open=false;
      },{signal});
      document.addEventListener('keydown',event=>{
        if(event.key==='Escape' && stats?.open){event.preventDefault();stats.open=false;stats.querySelector('summary')?.focus({preventScroll:true});}
      },{signal});
      const stage=this.querySelector<HTMLElement>('.quest-stage')!;
      stage.addEventListener('dragstart',event=>event.preventDefault(),{signal});
      this.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach(button=>button.addEventListener('click',()=>this.world?.zoom(Number(button.dataset.zoom)),{signal}));
      this.querySelector('canvas')?.addEventListener('pointerdown',()=>stage.focus({preventScroll:true}),{signal});
      stage.addEventListener('keydown',event=>{
        if(event.target!==stage||event.altKey||event.metaKey||event.ctrlKey)return;
        if(event.repeat)return;
        if(event.key==='+'||event.key==='='||event.key==='-'){event.preventDefault();this.world?.zoom(event.key==='-'?-.1:.1);}
        else if(event.key==='Enter'){event.preventDefault();this.openStation();}
        else if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();this.travel(event.key==='ArrowRight'?1:-1);}
      },{signal});
      document.addEventListener('keydown',event=>{
        if(event.target!==document.body||event.altKey||event.metaKey||event.ctrlKey||event.repeat)return;
        const bounds=stage.getBoundingClientRect();
        if(bounds.top>innerHeight*.35||bounds.bottom<innerHeight*.65)return;
        if(event.key==='Enter'){event.preventDefault();this.openStation();}
        else if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();this.travel(event.key==='ArrowRight'?1:-1);}
      },{signal});
      this.querySelector('[data-mobile-motion]')?.addEventListener('click',()=>{this.motion=!this.motion;this.updateMotion();},{signal});
      this.querySelector('[data-motion]')?.addEventListener('click', () => {this.motion=!this.motion;this.updateMotion();}, {signal});
      this.reduced.addEventListener('change', () => {this.motion=!this.reduced.matches;this.updateMotion();}, {signal});
      this.querySelector('[data-reset]')?.addEventListener('click', () => {
        resetProgress();
        if(this.dataset.world==='ready')this.world?.select(WORK_SLUGS[0]);else this.panFallback(-this.panPosition);
        this.activate(null);
        const status=this.querySelector('[data-reset-status]');if(status)status.textContent='Fresh journey started.';
      }, {signal});
      this.querySelector('[data-dismiss-reward]')?.addEventListener('click',()=>this.dismissReward(),{signal});
      window.addEventListener('work-progress', () => this.updateProgress(), {signal});
      document.addEventListener('work-quest-focus', event => {
        this.restoring=true;
        this.activate((event as CustomEvent<string>).detail);
        queueMicrotask(()=>{this.restoring=false;});
      }, {signal});
      document.addEventListener('work-quest-station-focus',()=>{this.pendingStationFocus=true;this.focusStationControl();},{signal});
      document.addEventListener('astro:before-preparation', () => this.persistPan(), {signal});
      window.addEventListener('pagehide', () => this.persistPan(), {signal});
      this.querySelector('.quest-stage')?.addEventListener('scroll', () => {
        if(this.dataset.world==='ready') return;
        const stage=this.querySelector<HTMLElement>('.quest-stage')!;
        this.onPan(stage.scrollLeft/Math.max(1,stage.scrollWidth-stage.clientWidth));
      }, {passive:true,signal});
      void this.loadWorld();
    }

    private loadingProgress(value:number) {
      this.style.setProperty('--load-progress',String(value/100));
      const label=this.querySelector('[data-load-percent]');if(label)label.textContent=`${value}%`;
    }
    private async loadWorld() {
      try {
        const { createWorkQuestWorld } = await import('./work-quest-world');
        if(!this.alive) return;
        this.loadingProgress(70);
        const savedPan=this.panPosition,savedStation=WORK_SLUGS.find(slug=>slug===history.state?.workQuestStation);
        let booting=true;
        this.world=createWorkQuestWorld(this.querySelector<HTMLCanvasElement>('canvas')!,{
          onProject: points => {
            for (const point of points) {
              const node=this.querySelector<HTMLElement>(`#${point.slug}`);
              if(!node) continue;
              node.toggleAttribute('data-outside',!point.visible);
              node.inert=!point.visible;
              node.style.setProperty('--node-x',`${point.x}px`);
              node.style.setProperty('--node-y',`${point.y}px`);
            }
          },
          onWorkshop: point => {
            const label=this.querySelector<HTMLElement>('[data-workshop-label]');if(!label)return;
            label.hidden=!point.visible;
            const half=label.offsetWidth/2;
            label.style.left=`${Math.max(half+12,Math.min(this.clientWidth-half-12,point.x))}px`;
            label.style.top=`${point.y}px`;
          },
          onSelect: (slug,event) => {
            if(slug==='open-source'){document.dispatchEvent(new Event('work-contributions-open'));return;}
            const link=this.querySelector<HTMLAnchorElement>(`[data-quest-select="${slug}"]`);
            if(!link)return;
            this.persistPan();
            if(event?.metaKey||event?.ctrlKey||event?.shiftKey) window.open(link.href,'_blank','noopener');
            else link.click();
          },
          onHover: slug => this.activate(slug,false),
          onPan: position => {if(!booting)this.onPan(position);},
          onStation: slug => {this.updateStation(slug);if(!booting)this.persistPan();},
          onReady: () => {worldHasLoaded=true;clearTimeout(this.loaderTimer);this.loaderTimer=window.setTimeout(()=>this.removeAttribute('data-loader-visible'),400);this.rewardTimer=window.setTimeout(()=>this.showReturnReward(),950);this.loadingProgress(100);this.removeAttribute('aria-busy');this.dataset.world='ready';this.updateStation(this.station);this.querySelector('.quest-stage')?.setAttribute('aria-label','Explore six project stories on the globe. Drag to choose the centered project. The monorail follows your view. Left and right arrows travel between stops. Enter opens the selected story.');this.querySelector('.quest-stage')!.scrollLeft=0;this.focusStationControl();},
          onError: () => this.fallback(),
        });
        this.world.setProgress(getProgress());
        this.world.setMotion(this.motion&&!document.querySelector('#open-source-dialog[open]'),!this.motion&&this.reduced.matches);
        this.world.setPan(savedPan);
        if(savedStation)this.world.restoreStation(savedStation);
        if(this.active)this.world.hover(this.active);
        booting=false;
        this.onPan(savedPan);
      } catch {this.fallback();}
    }

    private focusStationControl() {
      cancelAnimationFrame(this.focusFrame);this.focusFrame=0;
      if(!this.pendingStationFocus||!this.dataset.world||!this.alive)return;
      let target=this.querySelector<HTMLElement>('[data-station-link]');
      if(this.dataset.world==='fallback'){
        const bounds=this.querySelector('.quest-stage')!.getBoundingClientRect();
        const links=[...this.querySelectorAll<HTMLAnchorElement>('[data-quest-select]')];
        target=links.find(link=>{const r=link.getBoundingClientRect();return r.left>=bounds.left&&r.right<=bounds.right;})??links[0];
      }
      // During an Astro return, styles can finish after the renderer is ready.
      // A hidden anchor ignores focus, so wait for the actual visible control.
      if(!target||getComputedStyle(target).visibility!=='visible'||!target.getClientRects().length){
        this.focusFrame=requestAnimationFrame(()=>this.focusStationControl());return;
      }
      this.pendingStationFocus=false;
      const active=document.activeElement;
      if(active&&active!==document.body&&active!==document.documentElement&&active!==target)return;
      this.restoring=true;target.focus({preventScroll:true});queueMicrotask(()=>{this.restoring=false;});
    }
    private travel(direction:-1|1) {
      if(this.dataset.world==='ready')this.world?.step(direction);
      else this.panFallback(direction*.22);
    }
    private openStation() {
      if(this.dataset.world==='ready')this.querySelector<HTMLAnchorElement>('[data-station-link]')?.click();
    }
    private updateStation(slug:string) {
      if(!WORK_SLUGS.some(value=>value===slug))return;
      this.station=slug;this.dataset.station=slug;
      this.querySelectorAll<HTMLAnchorElement>('[data-quest-select]').forEach(link=>{
        const current=link.dataset.questSelect===slug;
        link.toggleAttribute('data-current-station',current);
        if(current)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');
      });
      const title=this.querySelector(`[data-quest-select="${slug}"] .stop-title`)?.textContent??slug;
      const link=this.querySelector<HTMLAnchorElement>('[data-station-link]');
      if(link){link.href=`/work/${slug}/`;link.setAttribute('aria-label',`Open ${title} story`);const name=link.querySelector('[data-station-name]');if(name)name.textContent=title;}
      this.updateStepControls();
    }
    private updateStepControls() {
      const index=WORK_SLUGS.findIndex(slug=>slug===this.station),ready=this.dataset.world==='ready';
      this.querySelector('[data-step="-1"]')?.toggleAttribute('disabled',ready?index===0:this.panPosition<.005);
      this.querySelector('[data-step="1"]')?.toggleAttribute('disabled',ready?index===WORK_SLUGS.length-1:this.panPosition>.995);
    }
    private activate(slug:string|null,forward=true) {
      this.active=slug;
      if(slug)this.dataset.selected=slug;else delete this.dataset.selected;
      this.querySelectorAll<HTMLElement>('[data-quest-select]').forEach(link=>link.toggleAttribute('data-active',link.dataset.questSelect===slug));
      if(forward)this.world?.hover(slug);
    }
    private onPan(position:number) {
      if(!Number.isFinite(position))return;
      this.panPosition=Math.max(0,Math.min(1,position));
      this.updateStepControls();
      clearTimeout(this.saveTimer);
      this.saveTimer=window.setTimeout(()=>this.persistPan(),250);
    }
    private persistPan() {
      clearTimeout(this.saveTimer);
      if(this.alive&&/^\/work\/?$/.test(location.pathname))history.replaceState({...history.state,workQuestPan:this.panPosition,workQuestStation:this.station},'');
    }
    private panFallback(delta:number) {
      const stage=this.querySelector<HTMLElement>('.quest-stage')!;
      const next=Math.max(0,Math.min(1,this.panPosition+delta));
      stage.scrollTo({left:next*(stage.scrollWidth-stage.clientWidth),behavior:this.motion?'smooth':'instant'});
      this.onPan(next);
    }
    private fallback() {
      clearTimeout(this.loaderTimer);this.removeAttribute('data-loader-visible');this.removeAttribute('aria-busy');this.dataset.world='fallback';
      this.rewardTimer=window.setTimeout(()=>this.showReturnReward(),950);
      this.querySelectorAll<HTMLElement>('.quest-stop').forEach(node=>{
        node.style.setProperty('--node-x',`${node.dataset.mapX}%`);node.style.setProperty('--node-y',`${node.dataset.mapY}%`);node.removeAttribute('data-outside');node.inert=false;
      });
      this.panFallback(0);
      this.focusStationControl();
    }
    private updateMotion() {
      const mobile=this.querySelector('[data-mobile-motion]');
      if(mobile) { mobile.textContent=this.motion?'Pause world motion':'Play world motion';mobile.setAttribute('aria-pressed',String(!this.motion)); }
      this.world?.setMotion(this.motion&&!document.querySelector('#open-source-dialog[open]'),!this.motion&&this.reduced.matches);
      const button=this.querySelector('[data-motion]');button?.setAttribute('aria-pressed',String(!this.motion));button?.setAttribute('aria-label',this.motion?'Pause world motion':'Play world motion');
      button?.querySelector('path')?.setAttribute('d',this.motion?'M3 1v8M7 1v8':'M3 1.5 8 5 3 8.5Z');
      button?.setAttribute('title',this.motion?'Pause motion':'Play motion');
      const label=button?.querySelector('[data-motion-label]');if(label)label.textContent=this.motion?'Pause':'Play';
    }
    private dismissReward(){
      const panel=this.querySelector<HTMLElement>('[data-journey-reward]');if(panel)panel.hidden=true;
      this.removeAttribute('data-rewarding');this.querySelectorAll('[data-rewarded]').forEach(el=>el.removeAttribute('data-rewarded'));
      clearTimeout(this.rewardHideTimer);
    }
    private showReturnReward(){
      if(!this.alive)return;
      if(document.documentElement.dataset.storyTravel){this.rewardTimer=window.setTimeout(()=>this.showReturnReward(),150);return;}
      this.updateProgress();
      const rewards=takeWorkRewards();if(!rewards.length)return;
      const reward=rewards.find(r=>r.slug===this.station)??rewards[rewards.length-1];
      const gained=rewards.reduce((sum,r)=>sum+r.to-r.from,0),summary=getSummary();
      const oldLevel=summary.level-rewards.filter(r=>r.from<100&&r.to===100).length;
      const link=this.querySelector<HTMLElement>(`[data-quest-select="${reward.slug}"]`);
      const title=link?.querySelector('.stop-title')?.textContent??'Story';
      const panel=this.querySelector<HTMLElement>('[data-journey-reward]')!;
      panel.querySelector('[data-reward-title]')!.textContent=reward.to===100?`${title} complete`:`${title}: ${reward.to}% explored`;
      panel.querySelector('[data-reward-detail]')!.textContent=`${reward.from}% → ${reward.to}% · +${gained} XP${summary.level>oldLevel?` · Level ${summary.level}!`:''}`;
      panel.querySelector('.reward-symbol')!.textContent=reward.to===100?'✓':'+';
      panel.hidden=false;this.setAttribute('data-rewarding','');link?.setAttribute('data-rewarded','');
      this.rewardHideTimer=window.setTimeout(()=>this.dismissReward(),7500);
    }
    private updateProgress() {
      const progress=getProgress(),summary=getSummary();
      const set=(selector:string,value:number)=>{const el=this.querySelector(selector);if(el)el.textContent=String(value);};
      set('[data-xp]',summary.xp);set('[data-level]',summary.level);set('[data-completed]',summary.completed);
      this.style.setProperty('--journey-progress',String(summary.xp/600));
      this.style.setProperty('--completion-percent',String(summary.completed/6*100));
      const next=this.querySelector('[data-next-level]');if(next)next.textContent=`${summary.completed} of 6 complete`;
      this.querySelector('.journey-stats summary')?.setAttribute('aria-label',`Exploration progress: level ${summary.level}, ${summary.xp} XP. Show details.`);
      WORK_SLUGS.forEach((slug,index)=>{
        const value=progress[slug]||0,link=this.querySelector<HTMLElement>(`[data-quest-select="${slug}"]`);if(!link)return;
        link.style.setProperty('--stop-progress',String(value));link.toggleAttribute('data-complete',value===100);
        const progressLabel=link.querySelector<HTMLElement>('[data-stop-progress-label]');if(progressLabel){progressLabel.hidden=value===0;progressLabel.textContent=value===100?'Complete':`${value}% explored`;}
