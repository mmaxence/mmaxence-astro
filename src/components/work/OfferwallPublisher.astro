---
import OfferwallCampaign from './OfferwallCampaign.astro';
interface Props { carousel?: boolean; }
const { carousel = false } = Astro.props;
---
<div class:list={['publisher-phone', { 'with-carousel': carousel }]} data-publisher-phone>
  <div class="publisher-status" aria-hidden="true"><span>9:41</span><span class="status-signals"><svg viewBox="0 0 24 12"><path d="M1 11V8M6 11V6M11 11V3M16 11V1"/><rect x="20" y="3" width="3" height="7"/></svg></span></div>
  <div class="publisher-appbar"><b>daylight<span>®</span></b><span class="avatar" aria-label="Alex's account">A</span></div>
  <div class="publisher-home">
    <div class="balance"><span>Your points</span><strong>12,440<small>P</small></strong><span class="balance-note">A little more, every day.</span></div>
    <div class="quick-actions"><div><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="15" rx="3"/><path d="M8 3v6m8-6v6M4 12h16m-11 5 2 2 4-4"/></svg><span>Daily check-in</span></div><div><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M2 21v-2a7 7 0 0 1 14 0v2m4-14v8m-4-4h8"/></svg><span>Invite a friend</span></div></div>
    <div class="activity"><div><span>Today’s steps</span><strong>4,820 <small>/ 8,000</small></strong></div><svg viewBox="0 0 44 44" aria-label="60 percent of today's step goal"><circle cx="22" cy="22" r="18"/><circle cx="22" cy="22" r="18" class="progress"/><path d="m16 23 4 4 8-10"/></svg></div>
  </div>
  {carousel ? <div class="carousel-placement">
    <div class="placement-heading"><strong>Discover & earn</strong><button type="button" data-open-feed>All offers</button></div>
    <div class="carousel-rail" tabindex="0" role="region" aria-label="Native ad carousel, swipe or use the controls below">
      <div class="carousel-card"><OfferwallCampaign brand="forme" /></div>
      <div class="carousel-card"><OfferwallCampaign brand="fieldwork" /></div>
      <div class="carousel-card more-card"><span class="more-mark" aria-hidden="true">P<span>+</span></span><span class="more-eyebrow">YOUR NEXT DISCOVERY</span><strong>There’s more<br/>in the Feed.</strong><p>One place for all your offers.</p><button type="button" data-open-feed>See all offers</button></div>
    </div>
    <div class="carousel-position" aria-hidden="true"><i class="active"></i><i></i><i></i></div>
  </div> : <>
    <div class="placement-slot">
    <div class="placement" data-placement="native"><div class="placement-heading"><strong>Discover & earn</strong><span>Picked for you</span></div><OfferwallCampaign eager /><button type="button" class="feed-link" data-open-feed>See all offers in the Feed</button></div>
    <div class="placement button-placement" data-placement="button" hidden><div class="reward-banner"><span class="reward-badge" aria-hidden="true">P</span><div><strong>Make more of your points.</strong><p>Discover brands. Find your next reward.</p></div><button type="button" data-open-feed>Explore rewards</button></div><div class="daily-note"><span>YOUR DAILY MOMENT</span><strong>Small steps.<br/>Good habits.</strong><p>Check in tomorrow to keep your streak going.</p></div></div>
    </div>
    <div class="sheet-dimmer" data-sheet-dimmer hidden></div>
    <div class="placement sheet-placement" data-placement="sheet" hidden><i class="sheet-handle" aria-hidden="true"></i><div class="sheet-heading"><strong>Rewards for you</strong><span>12,440 P</span></div><div class="sheet-tabs"><b>All offers</b><span>Visit</span><span>Shop</span></div><OfferwallCampaign eager /><button type="button" class="feed-link" data-open-feed>Open the full Feed</button></div>
  </>}
  <div class="publisher-bottom" aria-hidden="true"><span class="current"><svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8v10h-6v-7H9v7H3Z"/></svg>Home</span><span><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="15" rx="2"/><path d="M8 6V3h8v3m-1 7h6"/></svg>Rewards</span><span><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-3a8 8 0 0 1 16 0v3"/></svg>My page</span></div>
  <div class="home-indicator" aria-hidden="true"></div>
</div>
<style>
.publisher-phone{position:relative;display:flex;flex-direction:column;width:100%;max-width:330px;margin-inline:auto;min-width:0;border:5px solid #31372f;border-radius:31px;background:#fbfcf8;color:#28372c;overflow:hidden;font:12px/1.4 Arial,sans-serif;--theme-text:#28372c;--theme-text-muted:#61695e;container-type:inline-size}
.publisher-status{display:flex;justify-content:space-between;padding:12px 18px 9px;font:600 10px/1 Arial,sans-serif}.status-signals svg{width:27px;height:12px;fill:currentColor;stroke:currentColor;stroke-width:2}
.publisher-appbar{display:flex;align-items:center;justify-content:space-between;padding:8px 17px 17px}.publisher-appbar>b{font:600 26px/1 Arial,sans-serif;letter-spacing:-1.4px}.publisher-appbar>b>span{font:10px/1 Arial,sans-serif;vertical-align:top;letter-spacing:0;margin-left:2px}.avatar{display:grid;place-items:center;width:26px;height:26px;border:1px solid #d1d9c9;border-radius:50%;font:11px/1 Arial,sans-serif;background:#f0f3e8}
.publisher-home{padding:0 15px}.balance>span{font:11px/1.5 Arial,sans-serif;color:#646e60}.balance strong{display:block;font:600 clamp(26px,10cqi,32px)/1.2 Arial,sans-serif;letter-spacing:-1px;margin-top:2px}.balance small{font-size:14px;letter-spacing:0;margin-left:5px}.balance .balance-note{display:block;margin-top:5px;font-size:10px}
.quick-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:15px}.quick-actions>div{display:flex;align-items:center;gap:7px;border:1px solid #dfe4d8;border-radius:8px;padding:10px 8px;font:10px/1.4 Arial,sans-serif;white-space:nowrap}.quick-actions svg{width:17px;height:17px;fill:none;stroke:#536846;stroke-width:1.6;flex-shrink:0}
.activity{display:flex;align-items:center;justify-content:space-between;margin-top:11px;padding:12px 13px;background:#edf2e6;border-radius:8px}.activity span{font:10px/1.4 Arial,sans-serif;color:#526348}.activity strong{display:block;font:600 19px/1.4 Arial,sans-serif;letter-spacing:-.3px;margin-top:2px}.activity small{font:10px/1.3 Arial,sans-serif;color:#66735d;letter-spacing:0}.activity svg{height:39px;width:39px;fill:none;stroke:#d3dec6;stroke-width:3}.activity .progress{stroke:#527643;stroke-dasharray:68 113;transform:rotate(-90deg);transform-origin:center}.activity path{stroke:#527643;stroke-width:1.5}
.placement-slot{position:relative}.placement{margin:17px 13px 0}.placement-slot>[data-placement-hidden=true]{visibility:hidden;pointer-events:none}.button-placement{position:absolute;inset:0}.placement[hidden],.sheet-dimmer[hidden]{display:none!important}.placement-heading{display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:9px}.placement-heading strong{font:600 12px/1.4 Arial,sans-serif}.placement-heading>span{font:9px/1.4 Arial,sans-serif;color:#747c6d}.placement-heading button{border:0;background:none;color:#365b42;text-decoration:underline;text-underline-offset:3px;font:11px/1.4 Arial,sans-serif;padding:5px 0;min-height:44px;cursor:pointer}
.feed-link{display:block;width:100%;min-height:44px;margin-top:5px;padding:10px 0;background:none;border:0;color:#345f4c;font:600 11px/1.4 Arial,sans-serif;cursor:pointer}.feed-link:hover{text-decoration:underline;text-underline-offset:4px}button:focus-visible,.carousel-rail:focus-visible{outline:2px solid #345f4c;outline-offset:3px}
.publisher-bottom{display:flex;justify-content:space-around;gap:15px;margin-top:auto;padding:12px 15px 5px;border-top:1px solid #e2e6dc;color:#858d7e;font:9px/1.3 Arial,sans-serif}.publisher-bottom>span{display:flex;flex-direction:column;align-items:center;gap:4px}.publisher-bottom .current{color:#345f4c}.publisher-bottom svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.5}.home-indicator{height:3px;width:30%;border-radius:4px;background:#29342c;margin:9px auto 6px}
.reward-banner{display:grid;grid-template-columns:27px 1fr;gap:10px;background:#e4edd9;border:1px solid #d3dfc6;border-radius:10px;padding:15px 12px}.reward-badge{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;border:1px solid #587743;color:#3b5a2c;font:600 16px/1 Arial,sans-serif}.reward-banner strong{font:600 13px/1.3 Arial,sans-serif}.reward-banner p{font:10px/1.5 Arial,sans-serif;color:#57694b;margin:5px 0 0}.reward-banner button{grid-column:1/-1;width:100%;min-height:44px;border:0;border-radius:6px;background:#345f4c;color:white;font:600 11px Arial,sans-serif;cursor:pointer}.daily-note{padding:20px 6px 23px}.daily-note>span{font:8px/1.5 Arial,sans-serif;letter-spacing:.1em;color:#6d7963}.daily-note strong{display:block;font:24px/1.1 Georgia,serif;margin-top:8px}.daily-note p{font:10px/1.6 Arial,sans-serif;color:#65715c;max-width:24ch;margin:10px 0 0}
.sheet-dimmer{position:absolute;inset:0;background:rgb(27 39 28 / .24);z-index:2}.sheet-placement{position:absolute;z-index:3;bottom:0;left:0;right:0;margin:0;padding:10px 13px 16px;background:#f8faf5;border-radius:20px 20px 0 0;border-top:1px solid #cad5c0}.sheet-handle{display:block;width:29px;height:3px;border-radius:3px;background:#b8c2b0;margin:0 auto 16px}.sheet-heading{display:flex;justify-content:space-between;align-items:center;gap:9px}.sheet-heading strong{font:600 16px Arial,sans-serif}.sheet-heading span{font:600 10px Arial,sans-serif;color:#416046}.sheet-tabs{display:flex;gap:15px;border-bottom:1px solid #d9e2d1;margin:13px 0;padding-bottom:9px;font:10px Arial,sans-serif;color:#6d7767}.sheet-tabs b{color:#345f4c}
.carousel-placement{margin-top:12px;padding-bottom:12px}.carousel-placement>.placement-heading{margin:0 15px 5px}.carousel-rail{display:flex;gap:10px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#a5b59c transparent;padding:2px 15px 8px;scroll-padding-inline:15px}.carousel-card{flex:0 0 calc(100% - 20px);min-width:0;scroll-snap-align:start}.more-card{display:flex;flex-direction:column;align-items:start;background:#e4edda;border:1px solid #cfddc0;border-radius:10px;padding:16px;min-height:220px}.more-mark{font:600 26px/1 Arial,sans-serif;display:flex;align-items:center;gap:4px;margin-bottom:20px;color:#436039}.more-mark>span{display:grid;place-items:center;font-size:20px;width:25px;height:25px;border:1px solid #7f996e;border-radius:50%}.more-eyebrow{font:8px/1.5 Arial,sans-serif;letter-spacing:.1em;color:#617555}.more-card>strong{font:400 27px/1.05 Georgia,serif;margin:8px 0}.more-card>p{font:10px/1.5 Arial,sans-serif;margin:0 0 17px;color:#5f7353}.more-card>button{background:#345f4c;border:0;border-radius:6px;color:#fff;padding:10px 13px;font:600 11px/1.4 Arial,sans-serif;min-height:44px;margin-top:auto;cursor:pointer}.carousel-position{display:flex;justify-content:center;gap:4px;padding-top:6px}.carousel-position i{width:4px;height:4px;background:#c7d0bf;border-radius:50%}.carousel-position i.active{background:#345f4c;width:12px;border-radius:3px}
@container(max-width:250px){.publisher-appbar{padding-inline:13px}.publisher-home{padding-inline:11px}.quick-actions{gap:5px}.quick-actions>div{gap:5px;font-size:9px;padding:9px 6px}.quick-actions svg{width:14px}.placement{margin-inline:9px}.sheet-placement{margin:0}.placement-heading>span{font-size:8px}.balance .balance-note{font-size:9px}}
</style>
