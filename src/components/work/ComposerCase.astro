.learning-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: clamp(1.25rem,3vw,3rem); }
.learning-item { min-width: 0; }
.learning-visual { height: 280px; padding: 1rem; display: flex; flex-direction: column; align-items: center; justify-content: space-between; background: var(--soft); }
.learning-stage { width: 100%; font: .6rem/1.5 var(--font-mono,monospace); color: var(--muted); }
.learning-visual-note { font: .55rem/1.5 var(--font-mono,monospace); color: var(--muted); text-align: center; }
.kit-pieces { width: min(100%,216px); display: grid; grid-template-columns: repeat(3,1fr); grid-auto-rows: 42px; gap: 6px; }
.kit-pieces>span { border: 1px solid var(--line); background: var(--theme-bg); display: flex; align-items: center; justify-content: center; padding: 10px; gap: 6px; }
.kit-pieces i { display: block; background: color-mix(in srgb,var(--theme-text) 20%,var(--theme-bg)); }
.kit-pieces .kit-wide { grid-column: span 2; justify-content: space-between; }
.kit-wide i:first-child { width: 24px; height: 20px; }
.kit-wide i:last-child { width: 60%; height: 5px; }
.kit-disc i { width: 20px; height: 20px; border-radius: 50%; background: transparent; border: 4px solid color-mix(in srgb,var(--theme-text) 20%,var(--theme-bg)); }
.kit-pieces .kit-pair { gap: 4px; }
.kit-pair i { width: 16px; height: 20px; }
.kit-pieces .kit-lines { flex-direction: column; gap: 4px; align-items: start; }
.kit-lines i { width: 100%; height: 3px; }
.kit-lines i:last-child { width: 60%; }
.harness-layers { width: min(100%,250px); padding: 12px; border: 1px dashed var(--line); }
.harness-layers>div { padding: 12px; border: 1px solid var(--line); }
.learning-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; width: min(100%,190px); }
.learning-inputs>span { min-height: 43px; padding: .5rem .3rem; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); background: var(--theme-bg); font: .65rem/1.5 var(--font-mono,monospace); text-align: center; }
.minimal-visual .learning-inputs>span { border-color: var(--theme-text-muted); }
.learning-item h3 { font: 400 clamp(.95rem,1.3vw,1.1rem)/1.4 var(--font-mono,monospace); letter-spacing: -.025em; margin: 1.3rem 0 .8rem; }
.learning-item>p { font: .85rem/1.75 var(--font-body,sans-serif); color: var(--muted); max-width: 42ch; }
.learning-footnote { margin-top: 1.75rem; font: .6rem/1.7 var(--font-mono,monospace); color: var(--muted); }
@media(max-width:850px) {
 .learning-grid { grid-template-columns: 1fr; gap: 2rem; }
 .learning-item { display: grid; grid-template-columns: minmax(220px,.85fr) 1fr; gap: .65rem 2rem; align-items: start; }
 .learning-visual { grid-column: 1; grid-row: 1/3; height: 250px; }
 .learning-item h3 { grid-column: 2; align-self: end; margin: 0; }
 .learning-item>p { grid-column: 2; }
}
@media(max-width:560px) {
 .learning-item { display: block; }
 .learning-visual { height: 260px; }
 .learning-item h3 { margin: 1.1rem 0 .65rem; }
 .learning-item>p { max-width: none; }
}
