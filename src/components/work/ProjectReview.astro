---
import type { ProjectReview } from '../../data/work';
interface Props { review: ProjectReview }
const { review } = Astro.props;
---
<details class="project-review">
  <summary>Review notes & sources</summary>
  <div class="review-body">
    <p class="review-intro">Reviewed · {review.updated ?? '10 October 2026'}. Figures, credits and publication questions remain open where noted.</p>
    <h3>Contribution and credits</h3><p>{review.credit}</p>
    {review.figures.length > 0 && <><h3>Figures in context</h3><dl>{review.figures.map(figure => <div><dt>{figure.value}</dt><dd>{figure.context}</dd></div>)}</dl></>}
    <h3>Questions for the next pass</h3><ul>{review.questions.map(question => <li>{question}</li>)}</ul>
    {review.sources.length > 0 && <><h3>Source material</h3><p class="source-note">Research references for this local draft. Some links require company access; reading dates and scope are recorded in the evidence boundaries.</p><ul class="source-links">{review.sources.map(source => <li><a href={source.url}>{source.label}</a></li>)}</ul></>}
    {review.boundaries.length > 0 && <details class="claim-notes"><summary>Evidence boundaries</summary><ul>{review.boundaries.map(note => <li>{note}</li>)}</ul></details>}
  </div>
</details>
<style>
.project-review { max-width:40rem; margin:3rem auto; border-block:1px solid var(--theme-border); padding:1rem 0; }
summary { cursor:pointer; font:.85rem/1.7 var(--font-mono,monospace); padding:.35rem 0; }
summary:focus-visible { outline:2px solid var(--theme-text); outline-offset:4px; }
.review-body { padding:1.25rem 0 .5rem; font-size:.9rem; line-height:1.75; }
h3 { font-family:var(--font-mono,monospace); font-size:.95rem; font-weight:400; margin:1.75rem 0 .75rem; }
p { margin:.5rem 0 1rem; }
.review-intro,.source-note { color:var(--theme-text-muted); font-size:.8rem; }
ul { padding-left:1.15rem; } li { margin:.7rem 0; }
dl > div { padding:.9rem 0; border-bottom:1px solid var(--theme-border); }
dt { font-family:var(--font-mono,monospace); margin-bottom:.35rem; }
dd { margin:0; color:var(--theme-text-muted); }
.source-links a { overflow-wrap:anywhere; }
.claim-notes { margin-top:1.5rem; }
</style>
