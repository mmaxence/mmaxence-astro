---
import StoryHero from './StoryHero.astro';
import StoryLearnings from './StoryLearnings.astro';
import type { WorkEntry } from '../../data/work';
interface Props {
  work: WorkEntry;
  headline: string;
  intro: string;
  role: string;
  coverNote?: string;
  website?: { label: string; url: string };
  websites?: { label: string; url: string }[];
  lessons?: { title: string; body: string }[];
}
const { work, headline, intro, role, coverNote, website, websites, lessons = [] } = Astro.props;
---
<div class="editorial-case">
  <StoryHero title={headline} {intro} links={websites ?? (website ? [website] : [])} caption={coverNote}>
    <Fragment slot="visual"><slot name="cover" /></Fragment>
  </StoryHero>

  <div class="case-body"><slot /></div>

  {lessons.length > 0 && <StoryLearnings {lessons} />}

</div>
<style>
.editorial-case { --case-line:var(--theme-border); --case-muted:var(--theme-text-muted); --case-soft:color-mix(in srgb,var(--theme-text) 4%,var(--theme-bg)); color:var(--theme-text); min-width:0; }
.case-body { min-width:0; }
a { color:inherit; text-underline-offset:5px; text-decoration-color:var(--case-line); }
a:hover { text-decoration-color:currentColor; }
a:focus-visible,summary:focus-visible { outline:2px solid var(--theme-text); outline-offset:4px; }

</style>
