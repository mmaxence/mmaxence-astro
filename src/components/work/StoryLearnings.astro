---
interface Props { title?: string; lessons?: { title: string; body: string }[] }
const { title = 'What I learned.', lessons = [] } = Astro.props;
---
<section class="story-learnings" aria-labelledby="story-learning-title">
  <h2 id="story-learning-title">{title.split('\n').map(line => <span>{line}</span>)}</h2>
  <div class="story-learning-copy">
    {lessons.map(lesson => <div><h3>{lesson.title}</h3><p>{lesson.body}</p></div>)}
    <slot />
  </div>
</section>
<style>
  .story-learnings { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); padding: 2rem 0; }
  h2 { margin: 0; font: var(--story-heading-weight, 400) clamp(2.3rem, 4vw, 4rem)/1.12 var(--story-display, var(--font-heading)); letter-spacing: -.035em; }
  h2 > span { display: block; }
  .story-learning-copy { display: grid; gap: 1.8rem; }
  h3 { margin: 0 0 .7rem; font: 500 1.15rem/1.5 var(--font-body); color: var(--theme-text); }
  p, .story-learning-copy :global(p) { margin: 0; font: 1rem/1.8 var(--font-body); color: var(--theme-text-muted); }
  @media(max-width:650px) { .story-learnings { grid-template-columns: 1fr; padding-block: 3rem; } h2 { font-size: clamp(2rem, 8vw, 3.2rem); } }
</style>
