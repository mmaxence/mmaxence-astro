---
interface Props { topic: string; problem: string; id?: string }
const { topic, problem, id } = Astro.props;
---
<section id={id} class="story-focus" aria-label={`Zoom in: ${topic}`}>
  <header><span class="focus-label"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5M7 10h6M10 7v6"/></svg>Zoom in · {topic}</span><p>{problem}</p></header>
  <slot />
</section>
<style>
.story-focus { margin: 2.5rem 0; padding: clamp(1rem,3vw,2.5rem); border: 1px solid var(--theme-border); border-radius: 4px; min-width: 0; }
.story-focus>header { max-width: 60ch; margin-bottom: 2rem; }
.focus-label { display: flex; align-items: center; gap: .65rem; font: .75rem/1.5 var(--font-mono,monospace); color: var(--theme-text-muted); }
.focus-label svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.3; flex-shrink: 0; }
.story-focus>header>p { margin: .75rem 0 0; font: 1.05rem/1.65 var(--font-body); color: var(--theme-text); }
.story-focus :global(.detail-spread) { margin-top: 0; }
</style>
