---
// Homepage section: kicker, then a 2-col editorial row (copy aside a framed
// visual panel with a discreet inspector-style corner label), then optional
// full-width blocks below. `flip` puts the visual on the left at lg+.
import AnimatedContent from '../ui/AnimatedContent.astro';

interface Props {
  title: string;
  id?: string;
  label?: string; // corner label on the visual frame; defaults to ".kebab-cased-title"
  flip?: boolean;
  openVisual?: boolean;
  delay?: number;
}

const { title, id, label, flip = false, openVisual = false, delay = 0 } = Astro.props;
const frameLabel = label ?? '.' + title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section id={id} class="flex flex-col items-center px-4 md:px-8 lg:px-12 py-20 md:py-28">
  <div class="w-full max-w-5xl mx-auto text-base leading-relaxed index text-theme">
    <AnimatedContent delay={delay}>
      <article class="w-full index-content-section">
        <h2 class="section-kicker" data-reveal style="--r: 0">{title}</h2>

        {openVisual ? (
          <>
            <div class="visual-study" data-reveal style="--r: 1">
              <slot name="visual" />
            </div>
            <div class="section-copy study-copy" data-reveal style="--r: 2">
              <slot name="pre-visual" />
              <slot name="aside" />
            </div>
          </>
        ) : (
          <div class="mt-10 md:mt-14 grid items-center gap-10 lg:gap-14 lg:grid-cols-2">
            <div class="section-copy" data-reveal style="--r: 1">
              <slot name="pre-visual" />
              <slot name="aside" />
            </div>
            <div class={`visual-frame ${flip ? 'lg:order-first' : ''}`} data-reveal style="--r: 2">
              <span class="visual-frame-label" aria-hidden="true">{frameLabel}</span>
              <slot name="visual" />
            </div>
          </div>
        )}

        {Astro.slots.has('post-visual') && (
          <div class="mt-12 md:mt-16" data-reveal style="--r: 3">
            <slot name="post-visual" />
          </div>
        )}
      </article>
    </AnimatedContent>
  </div>
</section>

<style>
  section { scroll-margin-top: 96px; }

  .visual-study {
    width: clamp(220px, 28vw, 300px);
    max-width: 100%;
    margin-block: 24px;
  }

  .study-copy { max-width: 42rem; }

  /* Soft framed panel for the section visual */
  .visual-frame {
    position: relative;
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--theme-text) 2.5%, var(--theme-bg));
    box-shadow: var(--theme-shadow);
    padding: 2.5rem 1.5rem;
  }

  @media (min-width: 768px) {
    .visual-frame {
      padding: 3rem 2rem;
    }
  }

  /* Inspector-style corner label sitting on the frame border */
  .visual-frame-label {
    position: absolute;
    top: 0;
    left: 1.25rem;
    transform: translateY(-50%);
    padding: 0.125rem 0.5rem;
    font-family: var(--theme-font-heading);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.5;
    color: var(--theme-text-muted);
    background: var(--theme-bg);
    border: 1px solid var(--theme-border);
    border-radius: 0.25rem;
    white-space: nowrap;
  }
</style>
