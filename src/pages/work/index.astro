---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionLinks from '../../components/ui/SectionLinks.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import PageContent from '../../components/ui/PageContent.astro';
import ThemeToast from '../../components/ui/ThemeToast.astro';
import TitleListItem from '../../components/ui/TitleListItem.astro';
import { workEntries } from '../../data/work';

const description = 'Products, systems and experiments. The calls behind them, the foundations that made them possible, and where they stand.';
const groups = [
  { id: 'independent', title: 'Independent experiments', description: 'Exploring how people and agents work together.' },
  { id: 'company', title: 'Building at Buzzvil', description: 'From the surfaces people use to the systems behind them.' },
];
---

<BaseLayout title="Work" description={description}>
  <Header />
  <PageContent>
    <div class="max-w-5xl mx-auto px-3 md:px-8 lg:px-12 py-12">
      <PageHeader title="Work" description="Selected products, systems and experiments. The thinking behind them, and what took shape." />
      <SectionLinks group="work" />
      {groups.map(group => (
        <section class="work-group" aria-labelledby={group.id}>
          <header class="group-heading"><h2 id={group.id}>{group.title}</h2></header>
          {workEntries.filter(w => w.group === group.id).map(w => (
            <article id={w.slug}>
              <TitleListItem title={w.title} href={`/work/${w.slug}/`} meta={w.years} />
            </article>
          ))}
        </section>
      ))}
    </div>
  </PageContent>
  <Footer /><ThemeToast />
</BaseLayout>
<style>
.work-group + .work-group { margin-top:3rem; }
.group-heading { margin-bottom:.5rem; }
.group-heading h2 { font-family:var(--font-mono, monospace); font-size:.75rem; font-weight:400; color:var(--theme-text-muted); margin:0; }
article { scroll-margin-top:8rem; }
</style>
