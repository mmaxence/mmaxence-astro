---
import WorkStoryLayout from '../../layouts/WorkStoryLayout.astro';
import { workEntries } from '../../data/work';
import { WORK_SLUGS } from '../../data/work-order';
import ComposerCase from '../../components/work/ComposerCase.astro';
import HanjiCase from '../../components/work/HanjiCase.astro';
import OfferwallCase from '../../components/work/OfferwallCase.astro';
import LockscreenCase from '../../components/work/LockscreenCase.astro';
import GameUACase from '../../components/work/GameUACase.astro';
import BuzzvilMediumsCase from '../../components/work/BuzzvilMediumsCase.astro';

export function getStaticPaths() {
  const orderedWork = WORK_SLUGS.map(slug => {
    const work = workEntries.find(entry => entry.slug === slug);
    if (!work) throw new Error(`Missing work entry: ${slug}`);
    return work;
  });
  return orderedWork.map((work, index) => ({
    params: { slug: work.slug },
    props: { work, next: orderedWork[index + 1] },
  }));
}
const { work, next } = Astro.props;
const cases = {
  'interaction-composer': ComposerCase,
  'hanji': HanjiCase,
  'offerwall': OfferwallCase,
  'lockscreen': LockscreenCase,
  'game-ua-multi-mission': GameUACase,
  'buzzvil-mediums': BuzzvilMediumsCase,
};
const CasePage = cases[work.slug as keyof typeof cases];
---
<WorkStoryLayout {work} {next}>
  <CasePage {work} />
</WorkStoryLayout>
