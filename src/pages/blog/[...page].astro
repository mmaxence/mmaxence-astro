---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import PageContent from '../../components/ui/PageContent.astro';
import AnimatedContent from '../../components/ui/AnimatedContent.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import CardGrid from '../../components/ui/CardGrid.astro';
import ThemeToast from '../../components/ui/ThemeToast.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const FIRST_PAGE_SIZE = 9;
  const OTHER_PAGE_SIZE = 10;

  const allPosts = (await getCollection('blog')).filter((post) => !post.data.draft);
  const featured = allPosts
    .filter((post) => post.data.featured)
    .sort((a, b) => (a.data.featured_order ?? 99) - (b.data.featured_order ?? 99));
  // "All writing" lists every post by date, including the ones highlighted in the
  // AI series above (they should appear in both places).
  const sorted = [...allPosts]
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const remaining = sorted.length - FIRST_PAGE_SIZE;
  const totalPages = remaining > 0
    ? 1 + Math.ceil(remaining / OTHER_PAGE_SIZE)
    : 1;

  return Array.from({ length: totalPages }, (_, i) => {
    const pageNum = i + 1;
    let posts: typeof sorted;
    if (pageNum === 1) {
      posts = sorted.slice(0, FIRST_PAGE_SIZE);
    } else {
      const start = FIRST_PAGE_SIZE + (pageNum - 2) * OTHER_PAGE_SIZE;
      posts = sorted.slice(start, start + OTHER_PAGE_SIZE);
    }
    return {
      params: { page: pageNum === 1 ? undefined : String(pageNum) },
      props: { posts, featured: pageNum === 1 ? featured : [], currentPage: pageNum, totalPages },
    };
  });
}

const { posts, featured, currentPage, totalPages } = Astro.props;
const isFirstPage = currentPage === 1;
const heroPost = isFirstPage ? posts[0] : null;
const gridPosts = isFirstPage ? posts.slice(1) : posts;

const prevUrl = currentPage > 1
  ? currentPage === 2 ? '/blog/' : `/blog/${currentPage - 1}/`
  : null;
const nextUrl = currentPage < totalPages
  ? `/blog/${currentPage + 1}/`
  : null;
---

<BaseLayout title="Blog" description="Essays on product design in the AI age: the systems people and agents design within, working in code, and the judgment that doesn't automate.">
  <Header />
  <PageContent class="flex flex-col items-center pb-4 min-h-screen">
    <div class="max-w-5xl mx-auto px-3 md:px-8 lg:px-12 py-12">
      <AnimatedContent delay={0}>
        <PageHeader
          title="Blog"
          description="Essays on product design in the AI age: the systems people and agents design within, working in code, and the judgment that doesn't automate."
        />
      </AnimatedContent>

      {isFirstPage && featured.length > 0 && (
        <div class="mb-16">
          <AnimatedContent delay={40}>
            <h2 class="text-xl md:text-2xl font-light font-body !mb-1 text-theme">The AI series</h2>
            <p class="text-sm text-theme-muted mb-6">Designing in the AI age, read in order.</p>
          </AnimatedContent>
          <AnimatedContent delay={60}>
            <ol class="start-here-path">
              {featured.map((post, index) => (
                <li class="start-here-item">
                  <a href={`/blog/${post.slug}/`} class="start-here-link">
                    <span class="start-here-num">{index + 1}</span>
                    {post.data.featured_image && (
                      <img src={post.data.featured_image} alt="" class="start-here-cover" loading="lazy" />
                    )}
                    <span class="start-here-text">
                      <span class="start-here-title">{post.data.title}</span>
                      {post.data.description && <span class="start-here-desc">{post.data.description}</span>}
                    </span>
                    <span class="start-here-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </AnimatedContent>
        </div>
      )}

      {isFirstPage && (
        <AnimatedContent delay={50}>
          <h2 class="text-xl md:text-2xl font-light font-body mb-8 mt-4 text-theme">All writing</h2>
        </AnimatedContent>
      )}

      {heroPost && (
        <div class="mb-12 md:mb-16">
          <AnimatedContent delay={50}>
            <BlogCard post={heroPost} featured />
          </AnimatedContent>
        </div>
      )}

      <CardGrid columns={2}>
        {gridPosts.map((post, index) => (
          <AnimatedContent delay={(isFirstPage ? index + 1 : index) * 50 + 100}>
            <BlogCard post={post} />
          </AnimatedContent>
        ))}
      </CardGrid>

      {totalPages > 1 && (
        <nav class="blog-pagination mt-16 pt-8 border-t border-theme" aria-label="Blog pagination">
          <div class="flex items-center justify-between gap-4">
            {prevUrl ? (
              <a href={prevUrl} class="blog-pagination-link group" data-nav="prev">
                <span class="text-base text-theme group-hover:text-theme-accent transition-colors">
                  Previous
                </span>
                <span class="hidden sm:inline blog-pagination-key">←</span>
              </a>
            ) : <div class="flex-1" />}

            <span class="text-sm text-theme-muted font-mono">
              {currentPage} / {totalPages}
            </span>

            {nextUrl ? (
              <a href={nextUrl} class="blog-pagination-link group" data-nav="next">
                <span class="hidden sm:inline blog-pagination-key">→</span>
                <span class="text-base text-theme group-hover:text-theme-accent transition-colors">
                  Next
                </span>
              </a>
            ) : <div class="flex-1" />}
          </div>
        </nav>
      )}
    </div>
  </PageContent>
  <Footer />
  <ThemeToast />
</BaseLayout>

<style>
  .blog-pagination-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    padding: 0.75rem 1rem;
    border: 1px solid var(--theme-border);
    border-radius: var(--theme-radius, 0.5rem);
    transition: border-color 0.2s ease;
  }

  .blog-pagination-link:hover {
    border-color: var(--theme-accent);
  }

  .blog-pagination-key {
    font-size: 0.65rem;
    font-family: var(--theme-font-heading);
    line-height: 1;
    min-width: 1.4em;
    text-align: center;
    padding: 0.25rem 0.4rem 0.2rem;
    border-top: 1px solid var(--theme-border);
    border-left: 1px solid var(--theme-border);
    border-right: 2px solid var(--theme-border);
    border-bottom: 3px solid var(--theme-border);
    border-radius: 0.25rem;
    background-color: var(--theme-bg);
    color: var(--theme-text-muted);
    opacity: 0.6;
  }

  /* The AI series — numbered reading path */
  .start-here-path {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--theme-border);
    border-radius: var(--theme-radius, 0.5rem);
    overflow: hidden;
  }
  .start-here-item + .start-here-item {
    border-top: 1px solid var(--theme-border);
  }
  .start-here-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: var(--theme-text);
    transition: background-color 0.2s ease;
  }
  .start-here-link:hover {
    background-color: color-mix(in srgb, var(--theme-text) 5%, transparent);
  }
  .start-here-num {
    flex-shrink: 0;
    width: 1.85rem;
    height: 1.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--theme-border);
    font-family: var(--theme-font-heading, monospace);
    font-size: 0.85rem;
    color: var(--theme-text-muted);
  }
  .start-here-cover {
    flex-shrink: 0;
    height: 34px;
    width: auto;
    max-width: 82px;
    object-fit: contain;
    border-radius: 3px;
    border: 1px solid var(--theme-border);
  }
  .start-here-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .start-here-title {
    font-size: 1rem;
    line-height: 1.3;
    color: var(--theme-text);
  }
  .start-here-desc {
    font-size: 0.85rem;
    color: var(--theme-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .start-here-arrow {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--theme-text-muted);
    opacity: 0;
    transform: translateX(-2px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .start-here-link:hover .start-here-arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  function initBlogPaginationNav() {
    const nav = document.querySelector('.blog-pagination');
    if (!nav) return;

    const prevLink = nav.querySelector('[data-nav="prev"]') as HTMLAnchorElement | null;
    const nextLink = nav.querySelector('[data-nav="next"]') as HTMLAnchorElement | null;

    function onKeydown(e: KeyboardEvent) {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      if (e.key === 'ArrowLeft' && prevLink) {
        prevLink.click();
      } else if (e.key === 'ArrowRight' && nextLink) {
        nextLink.click();
      }
    }

    document.addEventListener('keydown', onKeydown);

    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', onKeydown);
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogPaginationNav);
  } else {
    initBlogPaginationNav();
  }

  document.addEventListener('astro:page-load', () => {
    setTimeout(initBlogPaginationNav, 50);
  });
</script>
