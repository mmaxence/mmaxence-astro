---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionLinks from '../../components/ui/SectionLinks.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import PageContent from '../../components/ui/PageContent.astro';
import AnimatedContent from '../../components/ui/AnimatedContent.astro';
import TitleListItem from '../../components/ui/TitleListItem.astro';
import ThemeToast from '../../components/ui/ThemeToast.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const FIRST_PAGE_SIZE = 9;
  const OTHER_PAGE_SIZE = 10;

  const allPosts = (await getCollection('blog')).filter((post) => !post.data.draft);
  const featured = allPosts
    .filter((post) => post.data.featured)
    .sort((a, b) => (a.data.featured_order ?? 99) - (b.data.featured_order ?? 99));
  // "All writing" lists every post by date, including the ones highlighted in the
  // AI series above (they should appear in both places).
  const sorted = [...allPosts]
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const remaining = sorted.length - FIRST_PAGE_SIZE;
  const totalPages = remaining > 0
    ? 1 + Math.ceil(remaining / OTHER_PAGE_SIZE)
    : 1;

  return Array.from({ length: totalPages }, (_, i) => {
    const pageNum = i + 1;
    let posts: typeof sorted;
    if (pageNum === 1) {
      posts = sorted.slice(0, FIRST_PAGE_SIZE);
    } else {
      const start = FIRST_PAGE_SIZE + (pageNum - 2) * OTHER_PAGE_SIZE;
      posts = sorted.slice(start, start + OTHER_PAGE_SIZE);
    }
    return {
      params: { page: pageNum === 1 ? undefined : String(pageNum) },
      props: { posts, featured: pageNum === 1 ? featured : [], currentPage: pageNum, totalPages },
    };
  });
}

const { posts, featured, currentPage, totalPages } = Astro.props;
const isFirstPage = currentPage === 1;

const prevUrl = currentPage > 1
  ? currentPage === 2 ? '/blog/' : `/blog/${currentPage - 1}/`
  : null;
const nextUrl = currentPage < totalPages
  ? `/blog/${currentPage + 1}/`
  : null;
---

<BaseLayout title="Writing" description="Essays on product design in the AI age: the systems people and agents design within, working in code, and the judgment that doesn't automate.">
  <Header />
  <PageContent class="flex flex-col items-center pb-4 min-h-screen">
    <div class="w-full max-w-5xl mx-auto px-3 md:px-8 lg:px-12 py-12">
      <AnimatedContent delay={0}>
        <PageHeader
          title="Writing"
          description="Essays on product design in the AI age: the systems people and agents design within, working in code, and the judgment that doesn't automate."
        />
      <SectionLinks group="writing" />

      </AnimatedContent>

      {isFirstPage && featured.length > 0 && (
        <div class="mb-16">
          <AnimatedContent>
            <h2 class="text-2xl md:text-3xl font-mono font-light !mb-1 text-theme" data-reveal style="--r: 0">The AI series</h2>
            <p class="text-sm text-theme-muted mb-4" data-reveal style="--r: 1">Designing in the AI age, read in order.</p>
            <div class="reveal-rule mb-6" style="--r: 0" aria-hidden="true"></div>
            <ol class="start-here-path" data-reveal style="--r: 2">
              {featured.map((post, index) => (
                <li class="start-here-item" data-reveal style={`--r: ${3 + Math.min(index, 5)}`}>
                  <TitleListItem title={post.data.title} href={`/blog/${post.slug}/`} number={index + 1} />
                </li>
              ))}
            </ol>
          </AnimatedContent>
        </div>
      )}

      {isFirstPage && (
        <AnimatedContent>
          <h2 class="text-2xl md:text-3xl font-mono font-light mb-4 text-theme" data-reveal style="--r: 0">All writing</h2>
          <div class="reveal-rule mb-8" style="--r: 0" aria-hidden="true"></div>
        </AnimatedContent>
      )}

      <div aria-label="Writing archive">
        {posts.map(post => <TitleListItem title={post.data.title} href={`/blog/${post.slug}/`} date={post.data.date} heading={isFirstPage ? 'h3' : 'h2'} />)}
      </div>

      {totalPages > 1 && (
        <nav class="blog-pagination mt-16 pt-8 border-t border-theme" aria-label="Blog pagination">
          <div class="flex items-center justify-between gap-4">
            {prevUrl ? (
              <a href={prevUrl} class="blog-pagination-link group" data-nav="prev">
                <span class="text-base text-theme group-hover:text-theme-accent transition-colors">
                  Previous
                </span>
                <span class="hidden sm:inline blog-pagination-key">←</span>
              </a>
            ) : <div class="flex-1" />}

            <span class="text-sm text-theme-muted font-mono">
              {currentPage} / {totalPages}
            </span>

            {nextUrl ? (
              <a href={nextUrl} class="blog-pagination-link group" data-nav="next">
                <span class="hidden sm:inline blog-pagination-key">→</span>
                <span class="text-base text-theme group-hover:text-theme-accent transition-colors">
                  Next
                </span>
              </a>
            ) : <div class="flex-1" />}
          </div>
        </nav>
      )}
    </div>
  </PageContent>
  <Footer />
  <ThemeToast />
</BaseLayout>

<style>
  .blog-pagination-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    padding: 0.75rem 1rem;
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-card-inner);
    transition: border-color 0.2s ease;
  }

  .blog-pagination-link:hover {
    border-color: var(--theme-accent);
  }

  .blog-pagination-key {
    font-size: 0.65rem;
    font-family: var(--theme-font-heading);
    line-height: 1;
    min-width: 1.4em;
    text-align: center;
    padding: 0.25rem 0.4rem 0.2rem;
    border-top: 1px solid var(--theme-border);
    border-left: 1px solid var(--theme-border);
    border-right: 2px solid var(--theme-border);
    border-bottom: 3px solid var(--theme-border);
    border-radius: 0.25rem;
    background-color: var(--theme-bg);
    color: var(--theme-text-muted);
    opacity: 0.6;
  }

  .start-here-path { list-style:none; margin:0; padding:0; }
  .start-here-item { margin:0; }
</style>

<script>
  // Module-level flag: bind once per page view. astro:before-swap resets it so the
  // astro:page-load init re-binds against the fresh DOM after client-side navs.
  let paginationNavBound = false;

  function initBlogPaginationNav() {
    if (paginationNavBound) return;
    const nav = document.querySelector('.blog-pagination');
    if (!nav) return;

    const prevLink = nav.querySelector('[data-nav="prev"]') as HTMLAnchorElement | null;
    const nextLink = nav.querySelector('[data-nav="next"]') as HTMLAnchorElement | null;

    function onKeydown(e: KeyboardEvent) {
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      if (
        e.target instanceof HTMLInputElement ||
        e.target instanceof HTMLTextAreaElement ||
        (e.target instanceof HTMLElement && e.target.isContentEditable)
      ) return;

      if (e.key === 'ArrowLeft' && prevLink) {
        prevLink.click();
      } else if (e.key === 'ArrowRight' && nextLink) {
        nextLink.click();
      }
    }

    paginationNavBound = true;
    document.addEventListener('keydown', onKeydown);

    document.addEventListener('astro:before-swap', () => {
      paginationNavBound = false;
      document.removeEventListener('keydown', onKeydown);
    }, { once: true });
  }

  // Bind early on hard loads (astro:page-load only fires at window `load` there,
  // which slow images/analytics can delay); the flag prevents double-binding.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogPaginationNav, { once: true });
  } else {
    initBlogPaginationNav();
  }
  document.addEventListener('astro:page-load', initBlogPaginationNav);
</script>
