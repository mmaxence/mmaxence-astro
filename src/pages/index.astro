---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageContent from '../components/ui/PageContent.astro';
import AnimatedContent from '../components/ui/AnimatedContent.astro';
import CardGrid from '../components/ui/CardGrid.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import ThemeToast from '../components/ui/ThemeToast.astro';
import HeroShapes from '../components/home/HeroShapes.astro';
import {
  WhatIDoVisual,
  TheCraftVisual,
  HowIWorkVisual,
  BeyondTheRoleVisual,
  ExperienceSnapshotVisual
} from '../components/home/SectionVisuals.tsx';
import HomeSection from '../components/home/HomeSection.astro';
import SubstrateCTA from '../components/ui/SubstrateCTA.astro';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.featured)
  .sort((a, b) => (a.data.featured_order ?? 99) - (b.data.featured_order ?? 99))
  .slice(0, 3); // Featured posts, in start-here order

const featuredDeepdive = (await getCollection('deepdives'))
  .filter((post) => !post.data.draft && post.data.featured)
  .sort((a, b) => (a.data.featured_order ?? 99) - (b.data.featured_order ?? 99))[0];
---

<BaseLayout title="Maxence Mauduit · Designing what should exist, and the systems that build it" description="Product designer. 15 years across product, system, and brand, 12 at one company. I build the design infrastructure people and AI agents work within, and I still design in code.">
  <Header />
  <PageContent class="flex flex-col pb-4">
  <!-- Hero Section - Full Viewport -->
  <section class="min-h-screen flex flex-col items-center justify-center px-4 md:px-8 lg:px-12">
    <div class="w-full max-w-4xl mx-auto text-center">
      <AnimatedContent delay={0}>
        <div
          class="hero-profile-wrapper"
          id="hero-flip-zone"
          role="button"
          tabindex="0"
          aria-label="Maxence Mauduit — tap to flip the photo and theme"
        >
          <div class="profile-flip" id="profile-flip">
            <img class="profile-flip-backing" id="profile-flip-backing" src="/images/profile.jpeg" alt="" draggable="false" aria-hidden="true" />
            <div class="profile-flip-inner" id="profile-flip-inner">
              <img class="profile-face profile-face-front" src="/images/profile.jpeg" alt="Maxence Mauduit" width="240" height="240" draggable="false" />
              <img class="profile-face profile-face-back" src="/images/profile.jpeg" alt="" width="240" height="240" draggable="false" aria-hidden="true" />
            </div>
          </div>
          <HeroShapes />
        </div>
      </AnimatedContent>
      <AnimatedContent delay={100}>
        <h1 class="text-center text-4xl md:text-5xl m-0 font-heading font-normal text-theme">
          Crafting delightful experiences, shipping the systems behind them.
        </h1>
      </AnimatedContent>
      <AnimatedContent delay={200}>
        <p class="text-center mt-4 text-base md:text-lg font-body font-normal max-w-3xl mx-auto px-4 text-theme text-pretty">
          15 years in, and I still open a project the way my son opens a Lego box. 15 years sharpening judgment on what works and what does not. 12 years ago I was handed a hard problem: make ads feel magical. We are getting there. I lead, and I am still an IC, more than ever with AI. I explore freely, but I deliver in code, where our products live.
        </p>
      </AnimatedContent>
    </div>
  </section>
  
  <!-- Main Content Sections -->
    {/* WHAT I DO */}
    <HomeSection title="What I do">
      <p slot="pre-visual" class="section-lede text-balance">Most of the work happens before the screen. The hard part is deciding what should exist, and what does not deserve to.</p>
      <div slot="aside">
        <p class="mt-6 text-balance">My strength is taking problems that are still undefined, strategically sensitive, or technically constrained, and turning them into products teams can actually build and scale. Thanks to extensive domain knowledge and a strong craft DNA, I join frontier squads, building when there is nothing. Learning from these experiences, I build systems for designers, now also PMs, FEs, and agents, to build upon.</p>
        <p class="mt-6">
          <a href="/images/Maxence-Mauduit_Resume-2026.pdf" target="_blank" rel="noopener noreferrer" class="inline-card"><img src="/images/favicon.png" alt="" width="14" height="14" class="inline-card-icon" />View my resume</a> for a detailed overview of my experience and impact.
        </p>
      </div>
      <WhatIDoVisual slot="visual" client:visible />
    </HomeSection>
    
    {/* THE CRAFT */}
    <HomeSection title="The craft" flip>
      <p slot="pre-visual" class="section-lede text-balance">The work that matters most now is not drawing screens. It is encoding judgment into systems.</p>
      <div slot="aside">
        <p class="mt-6 text-balance">When judgment lives in the system, good things get made without anyone standing over the work. People design with them, agents design within them.</p>
      </div>
      <TheCraftVisual slot="visual" client:visible />
      <div slot="post-visual">
        <p class="max-w-3xl text-balance">From my first job in Paris, hand-coding interfaces in the early days of Bootstrap, to now, when design increasingly lives in code, I have always shaped products in their natural environment: the codebase. Building shared systems, prototyping interactions too complex for Figma, closing the gap between intent and implementation. AI agents turned it into something bigger: a design system built for an agent to use (@buzzvil/design-library), the interaction recipes and composer that sit on top, and a first ad campaign assembled by an agent and shipped to a live advertiser.</p>

        <div class="craft-grid craft-grid-3 mt-10">
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">Discernment</h3>
            <p class="text-base leading-relaxed text-theme-muted !mt-0">Deciding what deserves to exist, before anything is drawn or built.</p>
            <div class="ref-links">
              <a href="/blog/designing-above-the-interface" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />Designing Above the Interface</a>
              <a href="/blog/the-job-description-is-wrong" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />The Job Description Is Wrong</a>
            </div>
          </div>
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">Systems for agents</h3>
            <p class="text-base leading-relaxed text-theme-muted !mt-0">Design infrastructure that people and AI agents compose within, without losing the plot.</p>
            <div class="ref-links">
              <a href="/blog/the-flip" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />The Flip</a>
              <a href="/blog/when-the-interface-assembles-itself" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />When the Interface Assembles Itself</a>
              <a href="https://design.buzzvil.com" target="_blank" rel="noopener noreferrer" class="ref-link"><img src="https://www.google.com/s2/favicons?domain=design.buzzvil.com&sz=24" alt="" class="ref-icon" width="14" height="14" />Design Buzzvil</a>
            </div>
          </div>
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">In the codebase</h3>
            <p class="text-base leading-relaxed text-theme-muted !mt-0">Shaping products where they actually live, not in a mockup of them.</p>
            <div class="ref-links">
              <a href="/blog/from-paper-to-code" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />From Paper to Code</a>
              <a href="/blog/harnessing-ai-coding-agents" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />Harnessing AI Coding Agents</a>
            </div>
          </div>
        </div>
      </div>
    </HomeSection>

    {/* EXPERIENCE SNAPSHOT */}
    <HomeSection title="Experience snapshot" label=".experience">
      <p slot="pre-visual" class="section-lede text-balance">15 years of shaping products, building teams, and the systems that hold them together.</p>
      <div slot="aside">
        <p class="mt-6">Every stage feeds the next: define what should exist, systematize how it gets built, scale the people and platforms that carry it. For the full story, see my <a href="/timeline" class="inline-card"><img src="/images/favicon.png" alt="" width="14" height="14" class="inline-card-icon" />experience timeline</a>.</p>
      </div>
      <ExperienceSnapshotVisual slot="visual" client:visible />
      <div slot="post-visual">
        <div class="craft-grid craft-grid-2">
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">Product Designer & Design Leader</h3>
            <p class="text-sm text-theme-muted !mt-0 mb-4">Buzzvil · Seoul · 2014–Present</p>
            <ul class="space-y-2 list-none pl-0 mb-2">
              <li class="flex items-start">
                <span class="mr-2 text-theme-muted">•</span>
                <span>Helped shape and initiate the company's defining pivots (consumer to B2B SDK, then Offerwall), back when the right move was not yet obvious</span>
              </li>
              <li class="flex items-start">
                <span class="mr-2 text-theme-muted">•</span>
                <span>Shaped the first version of nearly every major product and monetization model</span>
              </li>
              <li class="flex items-start">
                <span class="mr-2 text-theme-muted">•</span>
                <span>Built a small, high-retention design team that ships through PRs</span>
              </li>
              <li class="flex items-start">
                <span class="mr-2 text-theme-muted">•</span>
                <span>Now building the agent-consumable design infrastructure the team and our AI agents compose within</span>
              </li>
            </ul>
            <div class="ref-links">
              <span class="ref-label">See also:</span>
              <a href="/blog/i-dont-like-ads" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />I Don't Like Ads</a>
              <a href="https://www.buzzvil.com/en/company/about_us" target="_blank" rel="noopener noreferrer" class="ref-link"><img src="https://www.google.com/s2/favicons?domain=buzzvil.com&sz=24" alt="" class="ref-icon" width="14" height="14" />About Us</a>
              <a href="https://docs.buzzvil.com/" target="_blank" rel="noopener noreferrer" class="ref-link"><img src="https://www.google.com/s2/favicons?domain=docs.buzzvil.com&sz=24" alt="" class="ref-icon" width="14" height="14" />Buzzvil Docs</a>
              <a href="https://design.buzzvil.com" target="_blank" rel="noopener noreferrer" class="ref-link"><img src="https://www.google.com/s2/favicons?domain=design.buzzvil.com&sz=24" alt="" class="ref-icon" width="14" height="14" />Design Buzzvil</a>
            </div>
          </div>
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">UX Design Lead</h3>
            <p class="text-sm text-theme-muted !mt-0 mb-4">CMS Group · Paris · 2011–2014</p>
            <ul class="space-y-2 list-none pl-0 mb-2">
              <li class="flex items-start">
                <span class="mr-2 text-theme-muted">•</span>
                <span>Led UX for enterprise and SaaS products</span>
              </li>
              <li class="flex items-start">
                <span class="mr-2 text-theme-muted">•</span>
                <span>Co-published research on co-design validation methods</span>
              </li>
              <li class="flex items-start">
                <span class="mr-2 text-theme-muted">•</span>
                <span>Built an education SaaS bridging design intent and production code</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </HomeSection>

    {/* HOW I WORK */}
    <HomeSection title="How I work" flip>
      <p slot="pre-visual" class="section-lede text-balance">Tight discovery loops, clear intent, and execution that doesn't depend on me.</p>
      <div slot="aside">
        <p class="mt-6 text-balance">Discovery is where I spend the effort: understanding the constraint, the tradeoff, the intent. Delivery is what that effort buys: fast, clean, and without rework.</p>
      </div>
      <HowIWorkVisual slot="visual" client:visible />
      <div slot="post-visual">
        <div class="craft-grid">
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">Deliberate thinking, fast execution</h3>
            <p class="text-base leading-relaxed text-theme-muted !mt-0">Investing heavily upfront to clarify constraints, tradeoffs, and intent, so execution moves quickly without rework.</p>
            <div class="ref-links">
              <a href="/blog/design-tempo" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />Design Tempo</a>
            </div>
          </div>
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">Systems over screens</h3>
            <p class="text-base leading-relaxed text-theme-muted !mt-0">Interaction models, primitives, and patterns that hold together across teams and iterations.</p>
            <div class="ref-links">
              <a href="/blog/design-system-at-buzzvil" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />Design System at Buzzvil</a>
            </div>
          </div>
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">Product ownership mindset</h3>
            <p class="text-base leading-relaxed text-theme-muted !mt-0">Designing with unit economics, engineering cost, and long-term maintainability in mind.</p>
            <div class="ref-links">
              <a href="/blog/high-output-management" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />High Output Management</a>
            </div>
          </div>
          <div class="craft-cell">
            <h3 class="text-base font-heading font-bold">Building teams that don't need me</h3>
            <p class="text-base leading-relaxed text-theme-muted !mt-0">Small teams designed to operate without constant oversight. Removing ambiguity early and becoming unnecessary over time.</p>
            <div class="ref-links">
              <a href="/blog/design-peer-reviews-to-support-our-team-growth" class="ref-link"><img src="/images/favicon.png" alt="" class="ref-icon" width="14" height="14" />Design Peer Reviews</a>
            </div>
          </div>
        </div>
      </div>
    </HomeSection>
    
    {/* BEYOND THE ROLE */}
    <HomeSection title="Beyond the role" label=".beyond">
      <p slot="pre-visual" class="section-lede text-balance">Sustainable pace, continuous learning, and systems thinking beyond work.</p>
      <div slot="aside">
        <p class="mt-6 text-balance">I value sustainable performance and depth over constant acceleration.</p>
        <p class="mt-4 text-balance">Outside of work, I'm a parent of two and spend my time learning how complex systems behave, from interaction design to human psychology. I wrote about that balance: <a href="/blog/life-in-sprint-mode-raising-two-kids-while-working-at-a-hyper-dynamic-korean-startup" class="inline-card"><img src="/images/favicon.png" alt="" width="14" height="14" class="inline-card-icon" />Life in Sprint Mode</a>.</p>
      </div>
      <BeyondTheRoleVisual slot="visual" client:visible />
    </HomeSection>
    
    {/* Featured Deep Dive */}
    {featuredDeepdive && (
      <section class="flex flex-col items-center px-4 md:px-8 lg:px-12 py-20 md:py-28">
        <div class="w-full max-w-5xl mx-auto text-base leading-relaxed index text-theme">
          <AnimatedContent>
            <div class="w-full">
              <h2 class="section-kicker" data-reveal style="--r: 0">Featured deep dive</h2>
              <a href={`/deepdives/${featuredDeepdive.slug}/`} class="featured-deepdive-card mt-8 block no-underline border-none hover:bg-transparent" data-reveal style="--r: 1">
                <article class="p-6 md:p-10">
                  <h3 class="text-2xl md:text-4xl font-mono font-light mb-3 text-theme">
                    {featuredDeepdive.data.title}
                  </h3>
                  {featuredDeepdive.data.description && (
                    <p class="text-base md:text-lg leading-relaxed text-theme-muted">
                      {featuredDeepdive.data.description}
                    </p>
                  )}
                  <p class="mt-6 text-sm font-mono text-theme">Read the deep dive →</p>
                </article>
              </a>
            </div>
          </AnimatedContent>
        </div>
      </section>
    )}

    {/* Blog Posts */}
    {blogPosts.length > 0 && (
      <section class="flex flex-col items-center px-4 md:px-8 lg:px-12 py-20 md:py-28">
        <div class="w-full max-w-5xl mx-auto text-base leading-relaxed index text-theme">
          <AnimatedContent>
            <div class="w-full">
              <h2 class="section-kicker" data-reveal style="--r: 0">Selected writing</h2>
              <CardGrid columns={3} class="mt-8">
                {blogPosts.map((post, index) => (
                  <AnimatedContent delay={index * 75}>
                    <BlogCard post={post} />
                  </AnimatedContent>
                ))}
              </CardGrid>
            </div>
          </AnimatedContent>
        </div>
      </section>
    )}

    {/* Substrate Newsletter CTA */}
    <SubstrateCTA variant="section" />

  </PageContent>
      <Footer />
      <ThemeToast />
    </BaseLayout>

<style>
  .hero-profile-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    outline: none;
  }

  .hero-profile-wrapper:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 6px;
    border-radius: 16px;
  }

  /* Pinch-to-spin easter egg: a suspended, two-faced disc */
  .profile-flip {
    /* caps at the size it had when the hero column was max-w-2xl */
    width: min(33%, 222px);
    aspect-ratio: 1 / 1;
    position: relative;
    z-index: 0;
    margin-bottom: -3.5rem;
    perspective: 1100px;
    cursor: pointer;
    outline: none;
    border-radius: 50%;
    overflow: hidden;
    /* recess tone behind the disc so the circle is never empty mid-spin */
    background-color: color-mix(in srgb, var(--theme-text) 26%, var(--theme-bg));
  }

  /* Soft, dimmed copy of the photo behind the disc — the "memory" bleeding
     through the gap as the disc tilts, instead of bare page. */
  .profile-flip-backing {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    filter: blur(10px) brightness(0.82) saturate(0.92);
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }

  /* Delicate inset shadow: the photo reads as a recessed "memory window" in the page */
  .profile-flip::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow:
      inset 0 0 18px 2px rgba(0, 0, 0, 0.26),
      inset 0 0 5px rgba(0, 0, 0, 0.16);
    pointer-events: none;
    z-index: 2;
  }

  .profile-flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .profile-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    user-select: none;
    -webkit-user-drag: none;
    display: block;
    transition: filter 0.2s ease;
  }

  .profile-face-back {
    transform: rotateX(180deg);
  }

  .profile-flip:hover .profile-face {
    filter: brightness(1.04);
  }

  .profile-flip:focus-visible {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--theme-text) 30%, transparent);
  }

  .hero-profile-wrapper :global(.hero-shapes-wrapper) {
    position: relative;
    z-index: 1;
  }

  /* Craft dimensions grid — 4 > 2 > 1 columns */
  .craft-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    border: 1px solid var(--theme-border);
    border-radius: var(--theme-radius);
    overflow: hidden;
    /* 1px borders between cells via background on parent */
    background: var(--theme-border);
  }

  .craft-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .craft-grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .craft-cell {
    padding: 1.25rem;
    background: var(--theme-bg);
    display: flex;
    flex-direction: column;
  }

  .craft-cell h3 {
    margin-bottom: 0.75rem !important;
    font-size: 1.125rem;
  }

  .craft-cell .ref-links {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--theme-border);
  }

  @media (max-width: 1024px) {
    .craft-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Odd cell counts: last cell spans the full row instead of leaving a hole */
    .craft-grid-3 .craft-cell:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .craft-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Featured deep dive card — same card language as blog/book cards */
  .featured-deepdive-card article {
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-card);
    box-shadow: var(--theme-shadow);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .featured-deepdive-card:hover article {
    border-color: var(--theme-accent);
    box-shadow: var(--shadow-hover);
    transform: translateY(-1px);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .index-content-section svg * {
      animation: none !important;
      transition: opacity 0.3s ease !important;
    }
  }

</style>

<script>
  // Hero easter egg: tap the photo/shapes to flip to the next photo, swap to a
  // matching theme, and bloom the shapes. Photo + theme are a pair; Reset returns both.
  let currentReset = null;

  function initProfileFlip() {
    const zone = document.getElementById('hero-flip-zone');
    const inner = document.getElementById('profile-flip-inner');
    if (!zone || !inner || zone.dataset.flipInit) return;
    zone.dataset.flipInit = '1';

    const front = inner.querySelector('.profile-face-front');
    const back = inner.querySelector('.profile-face-back');
    const backing = document.getElementById('profile-flip-backing');

    // Photo + matched theme pairs. [0] is the default (on load / after Reset).
    // Rhythm: alone, with-kid, alone, with-kid, ...
    const slides = [
      { src: '/images/profile.jpeg',        label: 'Ocean',       theme: { bg: '#eaf4fb', text: '#0b3a5b', muted: '#3a6f93', accent: '#0a5a8a', border: '#cfe6f5' } }, // beach
      { src: '/images/profile-carrier.jpg', label: 'Trailside',   theme: { bg: '#eef3ec', text: '#2f4a2e', muted: '#5a7257', accent: '#3a5d39', border: '#dbe6d7' } }, // hike
      { src: '/images/profile-work.jpg',    label: 'After hours',  theme: { bg: '#1c2340', text: '#e8eaf2', muted: '#aab0c8', accent: '#c4663a', border: '#2a3457' } }, // velvet couch
      { src: '/images/profile-porto.jpg',   label: 'Porto',       theme: { bg: '#fbf1e8', text: '#6e3b27', muted: '#9a6b54', accent: '#c0532b', border: '#f0ddca' } }, // porto
      { src: '/images/profile-cafe.jpg',    label: 'Café',        theme: { bg: '#f7f3ea', text: '#3a3326', muted: '#6b6150', accent: '#d9682e', border: '#ece5d6' } }, // cafe
      { src: '/images/profile-garden.jpg',  label: 'Garden',      theme: { bg: '#eaf1e6', text: '#27401f', muted: '#52704a', accent: '#3f6f8f', border: '#d6e3cf' } }, // garden
    ];
    const photos = slides.map((s) => s.src);
    photos.forEach((src) => {
      const pre = new Image();
      pre.src = src;
    });

    let index = 0;
    let busy = false;
    let currentSpin = null; // in-flight Web Animation, so a click can fast-forward it
    let queuedTarget = null; // () => targetIndex, queued while a spin is being fast-forwarded
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Restore the photo that pairs with the persisted theme (kept in sync on every flip).
    try {
      const saved = parseInt(localStorage.getItem('hero-photo-index') || '0', 10);
      if (saved > 0 && saved < photos.length) {
        index = saved;
        front.src = photos[index];
        backing.src = photos[index];
      }
    } catch (e) {}

    // The disc never teleports back to 0deg; it keeps spinning forward and the two
    // faces alternate as the front. Each flip only changes the currently HIDDEN face,
    // then spins it into view — so the face that comes to rest was rasterized DURING
    // the spin, and the resting frame never flashes the blurred backing. (The old
    // reset-to-0 swapped the front face while it was backface-hidden, then snapped it
    // forward before the browser had painted it, which blinked for one frame.)
    let rotation = 0; // current resting rotateX, in degrees

    async function flipTo(target) {
      if (busy) return;
      busy = true;
      try {
        // Even multiples of 180 leave the front face forward; odd, the back face.
        const frontForward = (((Math.round(rotation / 180) % 2) + 2) % 2) === 0;
        const landingFace = frontForward ? back : front; // the hidden face becomes the new front

        if (reduce) {
          front.src = photos[target];
          back.src = photos[target];
          document.dispatchEvent(new CustomEvent('hero-flip', { detail: { duration: 0 } }));
        } else {
          landingFace.src = photos[target];
          // Decode the landing image up front; the spin paints it as it rotates in.
          // decode() can hang (backgrounded tab, flaky network) — it's only an
          // optimization, so never let it block the flip for more than a beat.
          try {
            await Promise.race([landingFace.decode(), new Promise((r) => setTimeout(r, 350))]);
          } catch (e) { /* fall through */ }

          // Odd number of half-turns flips which face is forward, landing on the target.
          const halfTurns = [7, 9, 11][Math.floor(Math.random() * 3)];
          const from = rotation;
          const to = rotation + halfTurns * 180;
          const duration = 900 + halfTurns * 75;

          // accompany the spin with the shape choreography
          document.dispatchEvent(new CustomEvent('hero-flip', { detail: { duration } }));

          const spin = inner.animate(
            [
              { offset: 0, transform: `rotateX(${from}deg) scale(1)`, easing: 'cubic-bezier(0.5, 0, 0.75, 0.4)' },
              { offset: 0.08, transform: `rotateX(${from - 12}deg) scale(0.93)`, easing: 'cubic-bezier(0.16, 0.85, 0.28, 1)' },
              { offset: 1, transform: `rotateX(${to}deg) scale(1)` },
            ],
            { duration, fill: 'forwards' }
          );
          currentSpin = spin;
          try {
            await spin.finished;
          } catch (e) {
            /* cancelled mid-flight — land instantly below */
          }
          currentSpin = null;
          // Commit the landed orientation inline before cancelling, so there's no
          // one-frame revert to base.
          inner.style.transform = `rotateX(${to}deg) scale(1)`;
          spin.cancel();
          rotation = to;
        }
        index = target;
        try { localStorage.setItem('hero-photo-index', String(index)); } catch (e) {}
        backing.src = photos[index]; // the soft memory behind matches the new photo
      } finally {
        busy = false;
        // A click landed while we were spinning: honor it now, so rapid taps
        // keep advancing without waiting out each full spin.
        if (queuedTarget) {
          const queued = queuedTarget;
          queuedTarget = null;
          requestFlip(queued.getTarget, queued.withTheme);
        }
      }
    }

    // Route every flip request through here. If a spin is in flight, fast-forward
    // it (finish() jumps to the final frame) and queue this request — the flip's
    // cleanup then runs it immediately. withTheme=false flips the photo only
    // (used by Reset, where ThemeToast has already applied the default theme).
    function requestFlip(getTarget, withTheme = true) {
      if (busy) {
        queuedTarget = { getTarget, withTheme };
        if (currentSpin) currentSpin.finish();
        return;
      }
      const target = getTarget();
      if (withTheme && typeof window.applyHeroTheme === 'function') {
        const slide = slides[target];
        window.applyHeroTheme(slide.theme, slide.label);
      }
      flipTo(target);
    }

    // A tap advances the pair: matching theme first, then the spin + bloom.
    function advance() {
      requestFlip(() => (index + 1) % slides.length);
    }

    zone.addEventListener('click', advance);
    zone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        advance();
      }
    });

    // Hovering the hero teases the shapes with a gentler bloom.
    zone.addEventListener('mouseenter', () => {
      document.dispatchEvent(new CustomEvent('hero-hover'));
    });

    // The Reset button (theme -> default) returns the photo to [0] too.
    // Photo only: ThemeToast already applied the default theme — re-applying
    // slide 0's palette here would undo the reset.
    currentReset = () => requestFlip(() => 0, false);
  }

  // Single document listener (document persists across view transitions).
  document.addEventListener('hero-reset', () => {
    if (currentReset) currentReset();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProfileFlip);
  } else {
    initProfileFlip();
  }
  // Re-bind after Astro view-transition navigations (fresh DOM each time).
  document.addEventListener('astro:page-load', initProfileFlip);
</script>

