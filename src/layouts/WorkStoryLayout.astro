---
import BaseLayout from './BaseLayout.astro';
import WorkStoryNavigation from '../components/work/WorkStoryNavigation.astro';
import WorkStoryTransition from '../components/work/WorkStoryTransition.astro';
import WorkStoryImageViewer from '../components/work/WorkStoryImageViewer.astro';
import WorkReadingProgress from '../components/work/WorkReadingProgress.astro';
import type { WorkEntry } from '../data/work';
interface Props { work: WorkEntry; next: WorkEntry }
const { work, next } = Astro.props;
---
<BaseLayout title={work.title} description={work.kicker}>
  <div class="work-story" data-work-story={work.slug}>
    <WorkReadingProgress slug={work.slug} />
    <a class="story-exit no-underline" href={`/work/#${work.slug}`} data-story-exit aria-label={`Close ${work.title} and return to Work`} aria-keyshortcuts="Escape">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      <span>All work</span><kbd>Esc</kbd>
    </a>
    <main id="work-story-content" class="story-content">
      <slot />
      <nav class="story-ending" aria-label="Continue exploring work">
        <a href={`/work/#${work.slug}`} data-story-exit>All work</a>
        <a href={`/work/${next.slug}/`}><span>Next project</span>{next.title}</a>
      </nav>
    </main>
    <WorkStoryImageViewer />
  </div>
  <WorkStoryNavigation /><WorkStoryTransition />
</BaseLayout>
<style is:global>
  @font-face { font-family: 'Hanji Story Sans'; src: url('/work/hanji/fonts/dmsans.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'Hanji Story Serif'; src: url('/work/hanji/fonts/newsreader.woff2') format('woff2'); font-weight: 200 800; font-display: swap; }
  @font-face { font-family: 'Hanji Story Serif'; src: url('/work/hanji/fonts/newsreader-italic.woff2') format('woff2'); font-weight: 200 800; font-style: italic; font-display: swap; }
  .work-story {
    --theme-bg: #171815; --theme-text: #f0eee7; --theme-text-muted: #b6b7ad; --theme-border: #393b33; --theme-accent: #e3c794; --theme-highlight: #464431;
    --story-display: 'Plus Jakarta Sans', sans-serif; --story-heading-weight: 400;
    --theme-font-body: 'Plus Jakarta Sans', sans-serif; --theme-font-heading: var(--story-display);
    --font-body: var(--theme-font-body); --font-heading: var(--theme-font-heading); --font-mono: 'Anonymous Pro', monospace;
    --color-text: var(--theme-text); --color-text-muted: var(--theme-text-muted); --color-text-light: var(--theme-text-muted); --color-bg: var(--theme-bg); --color-bg-muted: var(--theme-bg); --color-accent: var(--theme-accent); --color-accent-hover: var(--theme-accent); --color-border: var(--theme-border); --color-border-light: var(--theme-border); --color-highlight: var(--theme-highlight);
    --theme-shadow: none; --theme-radius: .5rem;
    min-height: 100svh; background: var(--theme-bg); color: var(--theme-text); font-family: var(--font-body); isolation: isolate;
  }
  .work-story[data-work-story='hanji'] {
    --theme-bg: #151714; --theme-text: #eeeee7; --theme-text-muted: #b3b6ac; --theme-border: #373b32; --theme-accent: #d5d8cb; --theme-highlight: #444b3b;
    --story-display: 'Hanji Story Serif', Georgia, serif; --story-body: 'Hanji Story Sans', Arial, sans-serif;
    --theme-font-body: var(--story-body); --theme-font-heading: var(--story-display);
  }
  .work-story[data-work-story='game-ua-multi-mission'] {
    --theme-bg: #111923; --theme-text: #eff5f3; --theme-text-muted: #aebfc5; --theme-border: #33434b; --theme-accent: #a9e6bf; --theme-highlight: #294638;
    --story-heading-weight: 600;
  }
  .work-story[data-work-story='interaction-composer'] {
    --theme-bg: #16161d; --theme-text: #eeedf5; --theme-text-muted: #b8b6c8; --theme-border: #3a3848; --theme-accent: #c2b8ef; --theme-highlight: #423b59;
    --story-display: 'Anonymous Pro', monospace;
  }
  .work-story[data-work-story='buzzvil-mediums'] {
    --theme-bg: #19181b; --theme-text: #f6f0ed; --theme-text-muted: #c1b6b4; --theme-border: #423a3c; --theme-accent: #ff9a94; --theme-highlight: #533a3c;
    --story-heading-weight: 600;
  }
  /* Product artifacts retain their own light canvas within the dark story. */
  .story-artifact {
    --theme-bg: #f7f7f3; --theme-text: #292b27; --theme-text-muted: #63675e; --theme-border: #d4d8ce; --theme-accent: #292b27; --theme-highlight: #eee8bd;
    --color-bg: var(--theme-bg); --color-bg-muted: #efefe9; --color-text: var(--theme-text); --color-text-muted: var(--theme-text-muted); --color-text-light: var(--theme-text-muted); --color-border: var(--theme-border); --color-border-light: var(--theme-border); --color-accent: var(--theme-accent);
    --line: var(--theme-border); --muted: var(--theme-text-muted); --soft: #eeeeE8;
    --case-line: var(--theme-border); --case-muted: var(--theme-text-muted); --case-soft: var(--soft);
    color: var(--theme-text); background: var(--theme-bg); border-radius: 6px;
  }
  .work-story .story-content { width: min(100%, 1504px); margin: 0 auto; padding: 100px clamp(20px, 4vw, 64px) 44px; }
  .work-story .story-exit {
    position: fixed; top: max(20px, env(safe-area-inset-top)); right: max(28px, env(safe-area-inset-right)); z-index: 90;
    display: inline-flex; align-items: center; justify-content: center; gap: .65rem; min-height: 44px; padding: .65rem .9rem;
    border: 1px solid var(--theme-border); border-radius: 99px; background: var(--theme-bg); color: var(--theme-text);
    font: .8rem/1.3 var(--font-body); text-decoration: none; transition: background .18s ease, border-color .18s ease;
  }
  .work-story .story-exit > span { color: inherit; }
  .work-story .story-exit kbd { margin-left: .35rem; color: var(--theme-text-muted); font: .65rem/1.3 var(--font-mono); }
  .work-story .story-exit:hover { border-color: var(--theme-text-muted); background: color-mix(in srgb, var(--theme-bg) 93%, var(--theme-text)); }
  .work-story .story-exit:focus-visible { outline: 2px solid var(--theme-text); outline-offset: 4px; }
  .work-story :where(section[id],h2[id],div[id]) { scroll-margin-top: 96px; }
  .work-story .story-ending { display: flex; justify-content: space-between; gap: 2rem; margin: 1.5rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid var(--theme-border); }
  .work-story .story-ending a { display: grid; gap: .65rem; max-width: 50%; color: var(--theme-text); font: 1rem/1.5 var(--font-body); }
  .work-story .story-ending a:last-child { text-align: right; }
  .work-story .story-ending span { font: .65rem/1.6 var(--font-mono); color: var(--theme-text-muted); }
  .work-story .story-ending a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .work-story .story-ending a:focus-visible { outline: 2px solid var(--theme-text); outline-offset: 5px; }
  @media(max-width:600px) {
    .work-story .story-content { padding-top: 92px; padding-bottom: 28px; }
    .work-story .story-exit { top: max(12px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); padding-inline: .8rem; }
    .work-story .story-exit kbd { display: none; }
    .work-story .story-ending { gap: 1.5rem; margin-top: 3rem; }
    .work-story .story-ending a { font-size: .9rem; }
  }
  @media(prefers-reduced-motion: reduce) {
    .work-story .story-exit { transition: none; }
  }
</style>
