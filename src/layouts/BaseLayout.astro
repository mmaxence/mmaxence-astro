---
import { ClientRouter } from 'astro:transitions';
import JsonLd from '../components/ui/JsonLd.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  featured_image?: string;
  url?: string;
  type?: 'website' | 'article';
  date?: Date;
}

const { title = "Product Designer, CDO at buzzvil", description = "Product designer and design leader. 15 years across product, system, and brand — designing in code and building agent-consumable design systems.", featured_image, url, type = 'website', date } = Astro.props;
const siteTitle = "Product Designer, CDO at buzzvil";
const author = "Maxence Mauduit";
const siteUrl = "https://mmaxence.me";
const currentUrl = url || (Astro.url.pathname.endsWith('/') ? new URL(Astro.url.pathname, siteUrl).href : new URL(Astro.url.pathname + '/', siteUrl).href);
const ogImage = featured_image
  ? (featured_image.startsWith('http') ? featured_image : new URL(featured_image, siteUrl).href)
  : new URL('/images/mmaxence-og.png', siteUrl).href;
const ogImageAlt = featured_image ? title : 'Maxence Mauduit — Product Designer';
const ogIsCard = !featured_image; // branded fallback card, known dimensions (2100x1193)

// JSON-LD structured data
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Maxence Mauduit",
  "alternateName": "mmaxence",
  "url": siteUrl,
  "image": new URL('/images/mmaxence-og.png', siteUrl).href,
  "email": "contact@mmaxence.me",
  "jobTitle": "Chief Design Officer",
  "description": "Product designer and design leader. 15 years in product design, 12 at Buzzvil, across product, system, and brand. Designs in code and builds agent-consumable design systems and the tooling on top of them. Has led the pivots and the team that scaled the business toward IPO readiness, and remains a hands-on IC.",
  "worksFor": {
    "@type": "Organization",
    "name": "Buzzvil",
    "url": "https://www.buzzvil.com"
  },
  "homeLocation": { "@type": "Place", "name": "Seoul, South Korea" },
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "Arts et Métiers ParisTech (ENSAM)" },
    { "@type": "CollegeOrUniversity", "name": "L'École de Design Nantes Atlantique" }
  ],
  "sameAs": [
    "https://www.linkedin.com/in/mmaxence/",
    "https://github.com/mmaxence",
    "https://mmaxence.medium.com",
    "https://mmaxence.substack.com",
    "https://x.com/mmaxence",
    "https://bsky.app/profile/mmaxence.bsky.social"
  ],
  "knowsAbout": [
    "AI-native Design", "Design Engineering", "Design in Code", "Agent-consumable Design Systems",
    "Interaction Design", "Design Systems", "Product Design", "Product Management",
    "Server-driven UI", "React", "TypeScript", "Design Leadership", "UX Design"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Maxence Mauduit",
  "url": siteUrl,
  "description": "Maxence Mauduit is a product designer and design leader (CDO at Buzzvil). He designs in code, builds agent-consumable design systems, and works at the intersection of AI-native design, interaction systems, and execution.",
  "author": { "@type": "Person", "name": "Maxence Mauduit" }
};

const articleSchema = type === 'article' ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": currentUrl,
  "author": { "@type": "Person", "name": "Maxence Mauduit" },
  ...(ogImage && { "image": ogImage }),
  ...(date && { "datePublished": date.toISOString() }),
  "publisher": { "@type": "Person", "name": "Maxence Mauduit" }
} : null;

const jsonLdSchemas = [personSchema, websiteSchema, ...(articleSchema ? [articleSchema] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <!-- Self-hosted fonts: preload the critical weights so they're ready at first paint (no FOUT swap-flash) -->
    <link rel="preload" href="/fonts/plus-jakarta-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anonymous-pro-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={author} />
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" type="application/rss+xml" title="Maxence Mauduit — Blog" href={new URL('/rss.xml', siteUrl).href} />
    <title>{title === siteTitle ? title : `${title} | ${siteTitle}`}</title>

    {/* JSON-LD Structured Data */}
    {jsonLdSchemas.map((schema) => <JsonLd data={schema} />)}

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title === siteTitle ? title : `${title} | ${siteTitle}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogIsCard && <meta property="og:image:width" content="2100" />}
    {ogIsCard && <meta property="og:image:height" content="1193" />}
    {featured_image && (() => {
      // Determine image type from extension
      const ext = featured_image.split('.').pop()?.toLowerCase();
      const imageType = ext === 'jpg' || ext === 'jpeg' ? 'image/jpeg' : ext === 'png' ? 'image/png' : 'image/png';
      return <meta property="og:image:type" content={imageType} />;
    })()}
    <meta property="og:site_name" content={siteTitle} />
    
    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title === siteTitle ? title : `${title} | ${siteTitle}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:src" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    
    <ClientRouter />
    <script is:inline>
      // Initialize theme immediately to prevent flash
      // Also re-apply on page transitions
      (function() {
        // Mark JS-ready on <html> before first paint, so entrance-animated content
        // starts hidden and fades in once, instead of flashing visible then hiding.
        document.documentElement.classList.add('js-ready');
        const themes = {
          default: {
            '--theme-bg': '#ffffff',
            '--theme-text': '#1a1a1a',
            '--theme-text-muted': 'rgba(26, 26, 26, 0.6)',
            '--theme-accent': '#000000',
            '--theme-border': '#e5e7eb',
            '--theme-shadow': '0 2px 8px rgba(0, 0, 0, 0.08)',
            '--theme-highlight': '#FBF1A9',
            '--theme-radius': '0.5rem',
            '--theme-spacing': '1rem',
            '--theme-font-heading': "'Anonymous Pro', monospace",
            '--theme-font-body': "'Plus Jakarta Sans', sans-serif",
          },
        };
        // Only 'default' and 'random' are ever persisted; unknown saved values fall back to default.
        
        function applyTheme(themeName) {
          try {
            const root = document.documentElement;
            
            // Handle random theme
            if (themeName === 'random') {
              const savedThemeData = localStorage.getItem('random-theme-data');
              if (savedThemeData) {
                try {
                  const themeObj = JSON.parse(savedThemeData);
                  Object.keys(themeObj).forEach(key => {
                    root.style.setProperty(key, themeObj[key]);
                  });
                  root.setAttribute('data-theme', 'random');
                  return;
                } catch (e) {
                  // If parsing fails, fall through to default
                }
              }
            }
            
            // Apply predefined theme or default
            const theme = themes[themeName] || themes.default;
            Object.keys(theme).forEach(key => {
              root.style.setProperty(key, theme[key]);
            });
            root.setAttribute('data-theme', themeName || 'default');
          } catch (e) {
            // Fallback to default theme
            const root = document.documentElement;
            Object.keys(themes.default).forEach(key => {
              root.style.setProperty(key, themes.default[key]);
            });
            root.setAttribute('data-theme', 'default');
          }
        }
        
        // Apply theme immediately
        try {
          const savedTheme = localStorage.getItem('theme') || 'default';
          applyTheme(savedTheme);
        } catch (e) {
          applyTheme('default');
        }
        
        // Re-apply theme on page transitions (Astro View Transitions)
        // Don't use glitch on page load, only on manual theme changes
        document.addEventListener('astro:page-load', () => {
          try {
            const savedTheme = localStorage.getItem('theme') || 'default';
            applyTheme(savedTheme);
          } catch (e) {
            applyTheme('default');
          }
        });
        
        // Also listen for astro:after-swap (for compatibility)
        document.addEventListener('astro:after-swap', () => {
          try {
            const savedTheme = localStorage.getItem('theme') || 'default';
            applyTheme(savedTheme);
          } catch (e) {
            applyTheme('default');
          }
        });
      })();
    </script>
    <script src="/js/interactions.js" defer></script>
    <script>
      // Hover prefetch — rebinds after every navigation (view transitions swap in
      // fresh DOM, so a DOMContentLoaded-only binding dies after the first swap)
      (function() {
        'use strict';
        const prefetchedUrls = new Set();

        function bindPrefetch() {
          document.querySelectorAll('.prefetch-link[data-prefetch="true"]').forEach((link) => {
            link.addEventListener('mouseenter', () => {
              const url = link.href || link.getAttribute('href');

              if (url && !prefetchedUrls.has(url)) {
                const prefetchLink = document.createElement('link');
                prefetchLink.rel = 'prefetch';
                prefetchLink.href = url;
                prefetchLink.as = 'document';
                document.head.appendChild(prefetchLink);
                prefetchedUrls.add(url);
              }
            }, { once: true });
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindPrefetch, { once: true });
        } else {
          bindPrefetch();
        }
        document.addEventListener('astro:page-load', bindPrefetch);
      })();
    </script>
    {/* GoatCounter analytics */}
    <script data-goatcounter="https://mmaxence.goatcounter.com/count" async src="//gc.zgo.at/count.js" is:inline></script>
  </head>
      <body style="background-color: var(--theme-bg); transition: background-color 0.3s ease;">
        <slot />
      </body>
</html>

